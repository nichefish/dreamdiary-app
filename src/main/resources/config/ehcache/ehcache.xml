    <!-- 태그 -->
    <cache alias="tagContentEntityListByRef" uses-template="defaultTemplate" />
    <cache alias="tagSmpDtlEntity" uses-template="defaultTemplate" />

    <!-- 메타 -->
    <cache alias="metaContentEntityListByRef" uses-template="defaultTemplate" />
    <cache alias="metaSmpDtlEntity" uses-template="defaultTemplate" />
</config>


