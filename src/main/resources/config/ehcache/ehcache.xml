    <!-- 저널 결산 -->
    <cache alias="jrnlSumryTotalListByUser" uses-template="defaultTemplate" />
    <cache alias="jrnlSumryListByUser" uses-template="defaultTemplate" />
    <cache alias="jrnlSumryDtlDtoByUser" uses-template="defaultTemplate" />
    <cache alias="jrnlSumryYyDtlDtoByUser" uses-template="defaultTemplate" />

    <!-- 태그 -->
    <cache alias="tagContentEntityListByRef" uses-template="defaultTemplate" />
    <cache alias="tagSmpDtlEntity" uses-template="defaultTemplate" />

    <!-- 메타 -->
    <cache alias="metaContentEntityListByRef" uses-template="defaultTemplate" />
    <cache alias="metaSmpDtlEntity" uses-template="defaultTemplate" />
</config>

