<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.nicheblog.dreamdiary.feature.clsf.sectn.repository.mybatis.SectnMapper">

    <!-- 삭제 데이터 조회 -->
    <select id="getDeletedById" resultType="io.nicheblog.dreamdiary.feature.clsf.sectn.model.SectnDto">
        /* SectnMapper.getDeletedById */
        SELECT
            sectn.id AS id,
            sectn.ref_id AS refId,
            sectn.ref_content_type AS refContentType
        FROM sectn sectn
        WHERE sectn.id = #{id}
    </select>
</mapper>
