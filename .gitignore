# Workspace / agents
/.claude/
/.codex

# IDE / editor
/.idea/
/.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/logs/*
!/logs/.logfile_path.md

# Environment
/config/env/.env*
*.local

# Gradle / Java
/.gradle/
/build/
/buildSrc/.gradle/
/buildSrc/build/

# Backend generated/static vendor assets
/app/backend/src/test/resources/*
/app/backend/src/main/resources/static/css/*.css*

# Uploaded/generated files
/files/*
!/files/contents
!/files/reports/xlsx_template
!/files/upfiles/.file_upload_path.md
!/files/reports/pdf_temp/.pdf_generated_temp_path.md

# TypeScript / SCSS outputs served by Spring Boot
/static/**/*.js
/static/**/*.css*

# Vue SPA build output copied to Spring Boot
/static/vue-app/
/static/react-app/

# Metronic Vue source dump / vendor-heavy original assets
/app/frontend-vue/src/views/crafted/
/app/frontend-vue/src/views/LayoutBuilder.vue
/app/frontend-vue/public/media/

# frontend-vue local/build artifacts
/app/frontend-vue/node_modules/
/app/frontend-vue/dist/
/app/frontend-vue/dist-ssr/
/app/frontend-vue/coverage/
/app/frontend-vue/.DS_Store
/app/frontend-vue/yarn.lock
/app/frontend-vue/*.js
/app/frontend-vue/**/*.js
/app/frontend-vue/src/assets/css
/app/frontend-vue/src/platform/metronic/

/app/frontend-react/node_modules
/app/frontend-react/src/platform/metronic/

