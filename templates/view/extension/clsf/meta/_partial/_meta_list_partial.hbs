<#--
 * 태그 목록 partial
 * @see handlebars.ts
-->

<script type="text/x-handlebars-template" id="meta_list_partial" data-partial>
    <span class="text-muted cursor-pointer pe-1"
          onclick="{{module}}.select({{metaNo}}, '{{metaNm}}');"
          data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "view.meta.content-list"/>">
        #
        <span class="border-bottom text-primary fw-lighter opacity-hover">
            {{#if (exists ctgr)}}
               <span class="fs-7 text-noti">[{{ctgr}}]</span>
            {{/if}}
            {{metaNm}}
        </span>
    </span>
</script>
