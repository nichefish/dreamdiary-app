<#--
 * 저널 챕터(jrnl_chapter) - 등록 버튼 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="jrnl_chapter_reg_btn_partial" data-partial>
    <button type="button" class="btn btn-sm btn-light-primary btn-outlined ps-4 pe-3 py-2 cursor-pointer"
            onclick="dF.JrnlChapter.regModal({ jrnlDayNo: {{postNo}}, stdrdDt: '{{stdrdDt}}', jrnlDtWeekDay: '{{jrnlDtWeekDay}}' });"
            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.jrnl.chapter"/> <@spring.message "bs.tooltip.modal.reg"/>">
        <i class="bi bi-list-columns-reverse fs-4 pe-1"></i>
        <@spring.message "txt.jrnl.chapter.reg"/>
    </button>
</script>
