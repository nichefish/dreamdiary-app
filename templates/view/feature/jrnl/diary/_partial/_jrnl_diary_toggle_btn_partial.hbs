<#--
 * 저널 일기(jrnl_diary) - 글접기 버튼 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="jrnl_diary_toggle_btn_partial" data-partial>
    <button type="button"
            class="btn btn-sm ms-2 px-3 toggle-diary-btn {{#if (hasState state 'COLLAPSED')}}is-active{{/if}}"
            onclick="dF.JrnlDiary.toggle({{id}}, this)">
        <i class="bi bi-arrows-{{#if (hasState state 'COLLAPSED')}}expand{{else}}collapse{{/if}} pe-0 diary-toggle-icon"></i>
    </button>
</script>
