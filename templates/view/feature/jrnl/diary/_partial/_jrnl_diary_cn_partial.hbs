<#--
 * 저널 일기(jrnl_diary) - 내용 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="jrnl_diary_cn_partial" data-partial>
    <div class="{{#if (exists cnClass)}}{{cnClass}}{{else}}cn {{cnStateClass state}}{{/if}}">
        {{{markdownCn}}}
    </div>
    <!-- "더 보기" 버튼, <p> child 3개 이상일 때만 보임 (css) -->
    <button type="button" class="btn btn-xxs btn-active-light-info badge-light-primary btn-outlined expand-btn"
            onclick="dF.JrnlDayTag.expand(this);">
    </button>

    {{#if (exists tag.list)}}
        <div class="tags ms-2 mt-3">
            <i class="bi bi-tag"></i>
        {{#tag.list}}
            {{> tag_list_partial this module="dF.JrnlDiaryTag"}}
        {{/tag.list}}
        </div>
    {{/if}}
    {{#if (exists comment.list)}}
        {{#each comment.list}}
            {{> comment_list_partial this}}
        {{/each}}
    {{/if}}
</script>
