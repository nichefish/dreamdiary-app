<#--
 * 저널 결산 리뷰(jrnl_sumry_review) - 내용 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="jrnl_sumry_review_cn_partial" data-partial>
    <div class="{{#if (exists cnClass)}}{{cnClass}}{{else}}cn {{cnStateClass state}}{{/if}}">
        {{{markdownCn}}}
    </div>

    {{#if (exists tag.list)}}
        <div class="tags ms-2 mt-3">
            <i class="bi bi-tag"></i>
        {{#tag.list}}
            {{> tag_list_partial this module="dF.JrnlDiaryTag"}}
        {{/tag.list}}
        </div>
    {{/if}}
    {{#if (exists comment.list)}}
        {{#each comment.list}}
            {{> comment_list_partial this}}
        {{/each}}
    {{/if}}
</script>
