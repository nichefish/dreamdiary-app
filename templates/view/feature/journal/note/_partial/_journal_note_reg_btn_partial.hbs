<#--
 * 저널 노트(journal_note) - 등록 버튼 partial (DIARY 챕터에서만 include)
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_note_reg_btn_partial" data-partial>
    <button type="button" class="btn btn-sm btn-light-primary btn-outlined ps-4 pe-3 py-2 cursor-pointer"
            onclick="dF.JournalNote.regModal({ journalDayId: {{journalDayId}}, journalChapterId: {{id}}, stdrdDt: '{{stdrdDt}}', journalDateWeekDay: '{{journalDateWeekDay}}' });"
            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.note"/> <@spring.message "bs.tooltip.modal.reg"/>">
        <i class="bi bi-journal-text fs-4 pe-1"></i>
        <@spring.message "txt.journal.note.reg"/>
    </button>
</script>
