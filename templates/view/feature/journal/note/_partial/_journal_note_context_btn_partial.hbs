<#--
 * 저널 노트(journal_note) - 컨텍스트 메뉴 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_note_context_btn_partial" data-partial>
    <div class="me-0 d-flex align-items-center">
        <button class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary"
                data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"
                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.context.menu.show'/>">
            <i class="ki-solid ki-dots-horizontal fs-2x"></i>
        </button>
        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
            <div class="menu-item px-3">
                <div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase"><@spring.message 'txt.journal.note'/></div>
            </div>
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.journal.note'/> <@spring.message 'bs.tooltip.modal.mdf'/>">
                <div class="menu-link flex-stack px-3" onclick="dF.JournalNote.mdfModal({{id}});">
                    <@spring.message 'txt.comm.edit'/>
                    <i class="bi bi-pencil-square fs-8"></i>
                </div>
            </div>
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                 title="{{#if (exists history.historyTriggeredAt)}}<@spring.message 'txt.history'/>{{else}}<@spring.message 'txt.history.empty'/>{{/if}}">
                <div class="menu-link flex-stack px-3 {{#unless (exists history.historyTriggeredAt)}}disabled text-muted{{/unless}}"
                     {{#if (exists history.historyTriggeredAt)}}onclick="dF.History.modal.open('JOURNAL_NOTE', {{id}});"{{/if}}>
                    <@spring.message 'txt.history'/>
                    <i class="bi bi-clock-history fs-8"></i>
                </div>
            </div>
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.related-content.add'/>">
                <div class="menu-link flex-stack px-3" onclick="dF.RelatedContent.openAddModalBySource('JOURNAL_NOTE', {{id}});">
                    <@spring.message 'txt.related-content.add'/>
                    <i class="bi bi-link-45deg fs-8"></i>
                </div>
            </div>
            <div class="separator my-2"></div>
            <div class="menu-item px-3" data-kt-menu-trigger="hover" data-kt-menu-placement="right-end">
                <a href="#" class="menu-link px-3">
                    <span class="menu-title"><@spring.message 'txt.comm.status'/></span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="menu-sub menu-sub-dropdown w-175px py-4">
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.resolved'/>">
                                <input class="form-check-input w-30px h-20px cursor-pointer note-context-resolved-check" type="checkbox" value="1" {{#if (hasState state 'RESOLVED')}}checked="checked"{{/if}}
                                       onclick="dF.JournalNote.resolveAjax({{id}});">
                                <span class="form-check-label text-muted fs-7"><@spring.message 'txt.status.resolved'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="separator my-2"></div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.status.imprtc'/>">
                                <input class="form-check-input w-30px h-20px cursor-pointer note-context-imprtc-check" type="checkbox" value="1" {{#if (hasState state 'IMPRTC')}}checked="checked"{{/if}}
                                       onclick="dF.JournalNote.imprtcAjax({{id}});">
                                <span class="form-check-label text-muted fs-7"><@spring.message 'txt.status.imprtc'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.status.refrnc'/>">
                                <input class="form-check-input w-30px h-20px cursor-pointer note-context-refrnc-check" type="checkbox" value="1" {{#if (hasState state 'REFRNC')}}checked="checked"{{/if}}
                                       onclick="dF.JournalNote.refrncAjax({{id}});">
                                <span class="form-check-label text-muted fs-7"><@spring.message 'txt.status.refrnc'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.status.collapsed'/>">
                                <input class="form-check-input w-30px h-20px cursor-pointer note-context-collapsed-check" type="checkbox" value="1" {{#if (hasState state 'COLLAPSED')}}checked="checked"{{/if}}
                                       onclick="dF.JournalNote.collapseAjax({{id}});">
                                <span class="form-check-label text-muted fs-7"><@spring.message 'txt.status.collapsed'/></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="separator my-2"></div>
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.journal.note'/> <@spring.message 'bs.tooltip.del'/>">
                <div class="menu-link flex-stack px-3 text-danger" onclick="dF.JournalNote.delAjax({{id}});">
                    <@spring.message 'txt.comm.del'/>
                    <i class="bi bi-trash text-danger p-0 fs-8"></i>
                </div>
            </div>
        </div>
    </div>
</script>
