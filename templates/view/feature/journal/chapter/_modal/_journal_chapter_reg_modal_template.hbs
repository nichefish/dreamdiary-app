<#--
 * journal_chapter > register/modify template
 * @included_in : _journal_chapter_reg_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_chapter_reg_modal_template">
    <input type="hidden" name="id" value="{{id}}">
    <input type="hidden" name="journalDayId" value="{{journalDayId}}">

    <#--begin::Row-->
    <div class="row d-flex mb-8">
        <div class="col-2">
            <label class="d-flex align-items-center mb-2" for="title">
                <span class="text-gray-700 fs-6 fw-bolder"><@spring.message "txt.journal.day"/></span>
            </label>
        </div>
        <div class="col-2 fs-6">
            <i class="bi bi-calendar3"></i>
            {{stdrdDt}}
            {{#if (exists journalDateWeekDay)}}
                <span class="fs-8 text-gray-600">({{journalDateWeekDay}})</span>
            {{/if}}
        </div>
    </div>

    <#--begin::Row-->
    <div class="row d-flex mb-8">
        <div class="col-12">
            <label class="d-flex align-items-center mb-2" for="title">
                <span class="text-gray-700 fs-6 fw-bolder"><@spring.message 'txt.title'/></span>
                <span class="text-gray-500 fs-9">(최대 50자)</span>
            </label>
        </div>
        <div class="col-lg-2">
            {{#if (exists id)}}
                {{#if (equals chapterType "DREAM")}}
                    <input type="hidden" name="chapterType" value="DREAM" />
                    <div class="form-control form-control-solid form-control-sm d-flex align-items-center min-h-40px">
                        <span class="fw-bolder"><@spring.message 'txt.dream'/></span>
                        <span class="text-muted fs-8 ms-2">(<@spring.message 'msg.journal.chapter.dream-auto-label'/>)</span>
                    </div>
                {{else}}
                    <select name="chapterType" id="chapterType" class="form-select form-select-solid">
                        <option value="DIARY" {{selectedIf (equals chapterType "DIARY")}}>일기</option>
                        <option value="NOTE" {{selectedIf (equals chapterType "NOTE")}}>노트</option>
                    </select>
                {{/if}}
            {{else}}
                <select name="chapterType" id="chapterType" class="form-select form-select-solid">
                    <option value="DIARY" {{selectedIf (equals chapterType "DIARY")}}>일기</option>
                    <option value="NOTE" {{selectedIf (equals chapterType "NOTE")}}>노트</option>
                </select>
            {{/if}}
        </div>
        <div class="col-lg-2">
            <select name="categoryCode" id="categoryCode" class="form-select form-select-solid">
                <option value="">--글분류--</option>
                <#list JOURNAL_CHAPTER_CTGR_CD![] as ctgr>
                    <option value="${ctgr.code!}" {{#if (equals categoryCode "${ctgr.code!}")}}selected{{/if}}>[${ctgr.codeName!}]</option>
                </#list>
            </select>
        </div>
        <div class="col-lg-{{#if (exists id)}}7{{else}}8{{/if}}">
            <input type="text" name="title" id="title" class="form-control"
                   value="{{title}}" placeholder="<@spring.message 'txt.title'/>" maxlength="100" />
            <div id="title_validate_span"></div>
        </div>
        {{#if (exists id)}}
            <div class="col-1 d-flex ps-0">
                <div class="d-flex-center p-2 fw-bold fs-5 text-gray-600">#</div>
                <input type="number" class="form-control form-control-sm" name="sortOrder" id="sortOrder" min="1" max="99"
                       value="{{sortOrder}}" placeholder="정렬순번" maxlength="3"
                       data-bs-toggle="tooltip" data-bs-placement="top" title="현재 일자 안에서의 챕터 정렬 순서입니다.">
            </div>
        {{/if}}
    </div>
</script>
