<#--
 * 저널 챕터(journal_chapter) 목록 조회 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_chapter_item_partial" data-partial>
    <div class="d-flex align-items-center mt-2">
        <div class="d-flex-align-center text-gray-700 fs-6 ps-1 ps-md-5 me-5 fw-bolder">
            <span class="{{#ifYn chapterResolvedYn}}text-success{{/ifYn}} me-2">
                {{#if (equals chapterType "DREAM")}}
                    <@spring.message 'txt.dream'/>
                {{else}}
                    {{#if (equals chapterType "NOTE")}}
                        <@spring.message 'txt.journal.note'/>
                    {{else}}
                        <@spring.message 'txt.diary'/>
                    {{/if}}
                {{/if}}
                {{#if (exists categoryCode)}}:{{/if}}
                {{#if (exists categoryCode)}}
                    <span style=color:#287D94;">{{categoryName}}</span>
                    <span class="text-muted fs-8 me-1">{{categoryCode}}</span>
                {{/if}}
            </span>
            {{#if (equals chapterType "DREAM")}}
                <i class="bi bi-moon-stars fs-4 {{#ifYn chapterResolvedYn}}text-success{{/ifYn}}"></i>
            {{else}}
                {{#if (equals chapterType "NOTE")}}
                    <i class="bi bi-journal-text fs-4 {{#ifYn chapterResolvedYn}}text-success{{/ifYn}}"></i>
                {{else}}
                    <i class="bi bi-book fs-4 {{#ifYn chapterResolvedYn}}text-success{{/ifYn}}"></i>
                {{/if}}
            {{/if}}
        </div>
        <div class="col-3 d-none d-md-flex align-items-center gap-2">
            {{#if (equals chapterType "DIARY")}}
                {{> journal_entry_reg_btn_by_type_partial this contentType="JOURNAL_DIARY" dayIdParam=journalDayId chapterIdParam=id}}
            {{/if}}
            {{#if (equals chapterType "NOTE")}}
                {{> journal_entry_reg_btn_by_type_partial this contentType="JOURNAL_DIARY" dayIdParam=journalDayId chapterIdParam=id}}
            {{/if}}
            {{#if (equals chapterType "DREAM")}}
                {{> journal_entry_reg_btn_by_type_partial this contentType="JOURNAL_DREAM" dayIdParam=journalDayId chapterIdParam=id}}
            {{/if}}
            {{> journal_chapter_copy_btn_partial this}}
            {{> journal_chapter_export_btn_partial this}}
            {{> journal_chapter_context_btn_partial this}}
            {{> journal_chapter_toggle_btn_partial this}}
        </div>
    </div>
    <div class="journal-chapter-item"
         data-id="{{id}}"
         data-stdrd-dt="{{stdrdDt}}"
         data-yy="{{yy}}"
         data-mnth="{{mnth}}"
         data-collapsed="{{hasState state 'COLLAPSED'}}"
         data-resolved="{{#ifYn chapterResolvedYn}}Y{{else}}N{{/ifYn}}">
        <div class="journal-chapter-content {{#if (hasState state 'COLLAPSED')}}collapsed{{/if}}">
            {{#if (equals chapterType "DIARY")}}
                {{#each journalEntryList}}
                    {{> journal_entry_item_by_type_partial this contentType="JOURNAL_DIARY"}}
                {{/each}}
            {{else}}
                {{#if (equals chapterType "NOTE")}}
                    {{#each journalEntryList}}
                        {{> journal_entry_item_by_type_partial this contentType="JOURNAL_DIARY"}}
                    {{/each}}
                {{/if}}
            {{/if}}
        </div>
        <div class="tags journal-chapter-tags ms-2 mt-3 {{#unless (hasState state 'COLLAPSED')}}d-none{{/unless}}">
            <i class="bi bi-tag"></i>
            {{#tag.list}}
                {{> tag_list_partial this module="dF.JournalEntryTag.get('JOURNAL_DIARY')"}}
            {{/tag.list}}
        </div>
    </div>
</script>
