<#--
 * journal_annual > journal entry tag list template
 * @included_in : journal_annual_dtl.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_annual_entry_tag_list_template">
    <div class="row d-flex flex-nowrap align-items-center w-100 mb-4 ms-4">
        <div class="col-1 d-none d-md-flex ms-4 me-6 text-center fs-6">
            <b>{{label}} : </b>
        </div>
        <div class="col">
            {{#each list}}
                {{> tag_list_sized_partial this module=../module}}
            {{else}}
                -
            {{/each}}
        </div>
        <div class="col-1 d-none d-md-flex ms-4 pe-0 border-2 border-gray-300 border-end h-75 w-10px">&nbsp;</div>
        <div class="col-1 d-none d-md-flex ms-4 me-20 text-center fs-6 w-auto gap-3">
            <button type="button" class="btn btn-sm btn-outline btn-light-primary px-4"
                    onclick="dF.Tag.hideSingleTag('#{{tagListDivId}}');"
                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.journal.annual.tag.hide-single'/>">
                <i class="bi bi-tag pe-0"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline btn-light-primary px-4"
                    onclick="dF.JournalTag.listAllAjax();"
                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.journal.annual.tag.open-all'/>">
                <i class="bi bi-tag pe-0"></i>
            </button>
        </div>
    </div>
</script>
