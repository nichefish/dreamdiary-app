<#--
 * 저널 일기(journal_diary) - 등록 버튼 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_diary_reg_btn_partial" data-partial>
    <button type="button" class="btn btn-sm btn-light-primary btn-outlined ps-4 pe-3 py-2 cursor-pointer"
            onclick="dF.JournalDiary.regModal({ journalDayId: {{journalDayId}}, journalChapterId: {{id}}, stdrdDt: '{{stdrdDt}}', journalDtWeekDay: '{{journalDtWeekDay}}' });"
            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.diary"/> <@spring.message "bs.tooltip.modal.reg"/>">
        <i class="bi bi-book fs-4 pe-1"></i>
        <@spring.message "txt.journal.diary.reg"/>
    </button>
</script>
