<#--
 * 저널 일자(journal_day) - 목록 조회 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_dream_item_partial" data-partial>
    <div class="journal-dream-item {{#if (hasState state 'COLLAPSED')}}is-collapsed{{/if}}"
         data-id="{{id}}"
         data-stdrd-dt="{{stdrdDt}}"
         data-yy="{{yy}}"
         data-mnth="{{mnth}}"
         data-collapsed="{{#if (hasState state 'COLLAPSED')}}Y{{else}}N{{/if}}"
         data-resolved="{{#if (hasState state 'RESOLVED')}}Y{{else}}N{{/if}}"
         data-imprtc="{{#if (hasState state 'IMPRTC')}}Y{{else}}N{{/if}}"
         data-refrnc="{{#if (hasState state 'REFRNC')}}Y{{else}}N{{/if}}">
        <div class="col-1 py-3 d-none d-md-flex-between border-2 border-gray-300 ps-5 me-2 h-75" style="width:85px;">
            <div class="d-flex flex-column align-items-center">
                <span class="journal-dream-idx {{#if (hasState state 'RESOLVED')}}text-success{{/if}}">
                    # {{sortOrder}}
                </span>
                {{> journal_dream_toggle_btn_partial this}}
            </div>
        </div>
        <div class="col">
            {{> journal_dream_states_partial this}}
            <div class="journal-dream-content p-2">
                {{> journal_dream_content_partial this}}
            </div>
        </div>
        <div class="col-1 d-none d-md-flex border-2 border-gray-300 border-end h-75 w-10px">&nbsp;</div>
        <div class="col-1 py-3 d-none d-md-flex-between w-75px ps-2 gap-1">
            {{> comment_reg_btn_partial this contentType="JOURNAL_DREAM"}}
            {{> journal_dream_copy_btn_partial this}}
            {{> journal_dream_context_btn_partial this}}
        </div>
    </div>
    <div class="journal-item">
        {{#each journalInterpretationList}}
            {{> journal_interpretation_item_partial this}}
        {{/each}}
    </div>
</script>
