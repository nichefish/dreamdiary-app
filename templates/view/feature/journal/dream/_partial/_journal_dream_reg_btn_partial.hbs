<#--
 * 저널 꿈(journal_dream) - 등록 버튼 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_dream_reg_btn_partial" data-partial>
    <button type="button" class="btn btn-sm btn-light-primary btn-outlined ps-4 pe-3 py-2 cursor-pointer"
            onclick="dF.JournalDream.regModal({ journalDayId: {{journalDayId}}{{#if journalChapterId}}, journalChapterId: {{journalChapterId}}{{/if}}, stdrdDt: '{{stdrdDt}}', journalDateWeekDay: '{{journalDateWeekDay}}' });"
            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.dream"/> <@spring.message "bs.tooltip.modal.reg"/>">
        <i class="bi bi-moon-stars fs-4 pe-1"></i>
        <@spring.message "txt.journal.dream.reg"/>
    </button>
</script>
