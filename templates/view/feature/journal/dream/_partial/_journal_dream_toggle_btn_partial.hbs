<#--
 * 저널 일기(journal_diary) - 글접기 버튼 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_dream_toggle_btn_partial" data-partial>
    <button type="button"
            class="btn btn-sm ms-2 px-3 toggle-dream-btn {{#if (hasState state 'COLLAPSED')}}is-active{{/if}}"
            onclick="dF.JournalDream.toggle({{id}}, this)">
        <i id="dream-toggle-icon-{{id}}" class="bi bi-arrows-{{#if (hasState state 'COLLAPSED')}}expand{{else}}collapse{{/if}} pe-0 dream-toggle-icon"></i>
    </button>
</script>
