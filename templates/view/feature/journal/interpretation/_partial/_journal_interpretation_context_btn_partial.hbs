<#--
 * 저널 해석(journal_interpretation) - 컨텍스트 버튼 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_interpretation_context_btn_partial" data-partial>
    <!-- Dropdown -->
    <div class="me-0 d-flex align-items-center">
        <button class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary"
                data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"
                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.context.menu.show'/>">
            <i class="ki-solid ki-dots-horizontal fs-2x"></i>
        </button>
        <!--begin::Menu 3-->
        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true" style="">
            <!--begin::Heading-->
            <div class="menu-item px-3">
                <div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase"><@spring.message "txt.journal.interpretation"/></div>
            </div>
            <!--end::Heading-->
            <!--begin::Menu item-->
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.interpretation"/> <@spring.message 'bs.tooltip.modal.mdf'/>">
                <div class="menu-link flex-stack px-3" onclick="dF.JournalInterpretation.mdfModal({{id}}, '{{stdrdDt}}');">
                    <@spring.message 'txt.comm.edit'/>
                    <i class="bi bi-pencil-square fs-8"></i>
                </div>
            </div>
            <!--end::Menu item-->
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                 title="{{#if (exists history.historyTriggeredAt)}}<@spring.message 'txt.history'/>{{else}}<@spring.message 'txt.history.empty'/>{{/if}}">
                <div class="menu-link flex-stack px-3 {{#unless (exists history.historyTriggeredAt)}}disabled text-muted{{/unless}}"
                     {{#if (exists history.historyTriggeredAt)}}onclick="dF.History.modal.open('JOURNAL_INTERPRETATION', {{id}});"{{/if}}>
                    <@spring.message 'txt.history'/>
                    <i class="bi bi-clock-history fs-8"></i>
                </div>
            </div>
            <div class="separator my-2"></div>
            <div class="menu-item px-3" data-kt-menu-trigger="hover" data-kt-menu-placement="right-end">
                <a href="#" class="menu-link px-3">
                    <span class="menu-title"><@spring.message 'txt.lifecycle'/></span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="menu-sub menu-sub-dropdown w-175px py-4">
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-check-custom form-check-solid cursor-pointer">
                                <input class="form-check-input w-18px h-18px cursor-pointer interpretation-context-lifecycle-check" type="radio" name="interpretation-lifecycle-{{id}}" value="OPEN" {{#if (equals lifecycle.lifecycleKey 'OPEN')}}checked="checked"{{/if}}
                                       onclick="dF.JournalInterpretation.setLifecycleAjax({{id}}, 'OPEN');">
                                <span class="form-check-label fs-7 {{#if (equals lifecycle.lifecycleKey 'OPEN')}}text-gray-800{{else}}text-muted{{/if}}"><@spring.message 'txt.lifecycle.open'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-check-custom form-check-solid cursor-pointer">
                                <input class="form-check-input w-18px h-18px cursor-pointer interpretation-context-lifecycle-check" type="radio" name="interpretation-lifecycle-{{id}}" value="PENDING" {{#if (equals lifecycle.lifecycleKey 'PENDING')}}checked="checked"{{/if}}
                                       onclick="dF.JournalInterpretation.setLifecycleAjax({{id}}, 'PENDING');">
                                <span class="form-check-label fs-7 {{#if (equals lifecycle.lifecycleKey 'PENDING')}}text-primary{{else}}text-muted{{/if}}"><@spring.message 'txt.lifecycle.pending'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-check-custom form-check-solid cursor-pointer">
                                <input class="form-check-input w-18px h-18px cursor-pointer interpretation-context-lifecycle-check interpretation-context-resolved-check" type="radio" name="interpretation-lifecycle-{{id}}" value="RESOLVED" {{#if (equals lifecycle.lifecycleKey 'RESOLVED')}}checked="checked"{{/if}}
                                       onclick="dF.JournalInterpretation.setLifecycleAjax({{id}}, 'RESOLVED');">
                                <span class="form-check-label fs-7 {{#if (equals lifecycle.lifecycleKey 'RESOLVED')}}text-success{{else}}text-muted{{/if}}"><@spring.message 'txt.status.resolved'/></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="separator my-2"></div>
            <!--begin::Menu item-->
            <div class="menu-item px-3" data-kt-menu-trigger="hover" data-kt-menu-placement="right-end">
                <a href="#" class="menu-link px-3">
                    <span class="menu-title"><@spring.message 'txt.comm.status'/></span>
                    <span class="menu-arrow"></span>
                </a>
                <!--begin::Menu sub-->
                <div class="menu-sub menu-sub-dropdown w-175px py-4">
                    <!--begin::Menu item-->
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <!--begin::Switch-->
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.imprtc'/>">
                                <!--begin::Input-->
                                <input class="form-check-input w-30px h-20px cursor-pointer" type="checkbox" value="1" {{#if (hasState state 'IMPRTC')}}checked="checked"{{/if}}>
                                <!--end::Input-->
                                <!--end::Label-->
                                <span class="form-check-label text-muted fs-7"><@spring.message 'txt.status.imprtc'/></span>
                                <!--end::Label-->
                            </label>
                            <!--end::Switch-->
                        </div>
                    </div>
                    <!--end::Menu item-->
                    <!--begin::Menu item-->
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <!--begin::Switch-->
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.status.collapsed'/>">
                                <!--begin::Input-->
                                <input class="form-check-input w-30px h-20px cursor-pointer diary-context-collapsed-check" type="checkbox" value="1" {{#if (hasState state 'COLLAPSED')}}checked="checked"{{/if}}
                                       onclick="dF.JournalEntry.get('JOURNAL_DIARY').collapseAjax({{id}});">
                                <!--end::Input-->
                                <!--end::Label-->
                                <span class="form-check-label text-muted fs-7"><@spring.message 'txt.status.collapsed'/></span>
                                <!--end::Label-->
                            </label>
                            <!--end::Switch-->
                        </div>
                    </div>
                    <!--end::Menu item-->
                </div>
                <!--end::Menu sub-->
            </div>
            <!--end::Menu item-->
            <!--begin::Menu separator-->
            <div class="separator my-2"></div>
            <!--end::Menu separator-->
            <!--begin::Menu item-->
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.interpretation"/> <@spring.message 'bs.tooltip.del'/>">
                <div class="menu-link flex-stack px-3 text-danger" onclick="dF.JournalInterpretation.delAjax({{id}});">
                    <@spring.message 'txt.comm.del'/>
                    <i class="bi bi-trash text-danger p-0 fs-8"></i>
                </div>
            </div>
            <!--end::Menu item-->
        </div>
        <!--end::Menu 3-->
    </div>
</script>
