<#--
 * 저널 결산(journal_sumry) 상세 조회 Template
 * @included_in : journal_sumry_list.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_sumry_dtl_template">
    <#--begin::Card body-->
    <div class="card-header py-5">
        <div class="col-2 d-flex align-items-center">
            <i class="bi bi-calendar3 fs-5 me-2"></i>
            {{#if (exists title)}}
                <span class="fs-4 me-1">{{title}}</span>
            {{else}}
                <span class="fs-4 fw-bolder me-1">{{yy}}</span>
                <span class="fs-5 me-1"><@spring.message 'txt.sumry-by-yy'/></span>

            {{/if}}
        </div>
        <div class="d-flex justify-content-start">
            <div class="d-flex-center text-gray-700 fs-6 me-5">
                <span class="fw-bold me-2">
                    <@spring.message 'txt.dream'/>
                </span>
                {{#ifYn dreamComptYn}}
                    <span class="cursor-help"
                          data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="꿈 기록을 완료했습니다.">
                        <i class="bi bi-moon-stars-fill fs-4 me-2 text-success"></i>
                        <i class="bi bi-check text-success" style="margin-left:-0.8rem"></i>
                    </span>
                {{else}}
                    <span>
                        <i class="bi bi-moon-stars fs-4 me-2"></i>
                    </span>
                {{/ifYn}}
                (<span class="text-info fw-bold mx-1">{{dreamDayCnt}}</span><@spring.message 'txt.dd'/>
                /
                <span class="text-info fw-bold mx-1">{{dreamCnt}}</span><@spring.message 'txt.ea'/>)
            </div>
        </div>
    </div>
    <div class="card-body py-5">
        <div class="journal-sumry-item">
            <div class="ms-3 fs-6">
                SUMMARY
            </div>
            <div class="fs-6 fw-normal text-gray-800 ps-2 pt-2 text-noti">
                {{{markdownCn}}}
            </div>
            <div class="mt-2">
                {{#if (exists tag.list)}}
                    <div class="ms-5 mt-3">
                        <i class="bi bi-tag"></i>
                        {{#tag.list}}
                            {{> tag_list_partial this module="dF.JournalDayTag"}}
                        {{/tag.list}}
                    </div>
                {{/if}}
            </div>
        </div>
        <div class="journal-sumry-review-container mt-8">
            <div class="d-flex-align-center ms-3 fs-6 gap-5">
                <span>REVIEWS</span>
                <button type="button" class="btn btn-sm btn-light-primary btn-outlined ps-2 pe-3 py-1 cursor-pointer"
                        onclick="dF.JournalSumryReview.regModal({ journalSumryId: {{id}} });"
                        data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.diary"/> <@spring.message "bs.tooltip.modal.reg"/>">
                    <i class="bi bi-plus fs-4 pe-0"></i>
                    <@spring.message "txt.journal.sumry.review.reg"/>
                </button>
            </div>
            {{#each journalSumryReviewList}}
                {{> journal_sumry_review_item_partial this}}
            {{/each}}
        </div>
    </div>
</script>
