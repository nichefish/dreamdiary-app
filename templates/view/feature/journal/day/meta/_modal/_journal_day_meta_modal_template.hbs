<#--
 * 저널 일자(journal_day) > 등록/수정 Template
 * @included_in : _journal_day_reg_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_day_meta_modal_template">
    <div class="d-flex flex-column mb-4">
        <div class="d-flex justify-content-start align-items-center gap-3 mb-4">
            <label for="journal_day_meta_yy" class="form-label mb-0 fw-bold"><@spring.message 'txt.yy'/></label>
            <select id="journal_day_meta_yy"
                    class="form-select form-select-sm w-auto"
                    onchange="dF.JournalDayMeta.changeYy({{metaId}}, this.value);">
                {{#each yearOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
            </select>
        </div>
        {{#each list}}
            {{!-- 저장된 previousMnth 변수를 비교 --}}
            {{^if (equals mnth (lookup @root._locals "prevMnth"))}}
                <div class="d-flex-center mt-6 mb-4 fs-5 text-dark">{{yy}}<@spring.message 'txt.date.suffix.after-year-number'/>{{mnth}}<@spring.message 'txt.date.suffix.after-month-number'/></div>
            {{/if}}

            <div class="d-flex align-items-center gap-2">
                {{> journal_day_stdrd_dt_partial this}}
                {{#each meta.list}}
                    {{#if (equals metaId ../../metaId)}}
                        <div>
                        {{#if (exists ctgr)}}<span class="text-noti pe-1">[{{ctgr}}]</span>{{/if}} {{metaNm}}{{#if (exists label)}} - <span>{{label}}</span>{{/if}} <span class="text-dialog">: {{value}}{{unit}}</span>
                        </div>
                        <div class="separator separator-dashed my-2"></div>
                        <button type="button" class="btn btn-sm btn-secondary btn-active-primary"
                                onclick="dF.JournalDay.openDetatched('{{../stdrdDt}}');">
                            <@spring.message "txt.comm.open-in-new-window"/>
                            <i class="bi bi-window-stack fs-7 ms-1 pe-0"></i>
                        </button>
                    {{/if}}
                {{/each}}
            </div>
            <div class="mb-4 d-flex-align-center">
                {{#if (exists tag.list)}}
                    <div class="ms-5 mt-3">
                        <i class="bi bi-tag"></i>
                        {{#tag.list}}
                            {{> tag_list_partial this module="dF.JournalDayTag"}}
                        {{/tag.list}}
                    </div>
                {{/if}}
            </div>

            {{!-- 현재 월을 previousMnth 변수로 저장 --}}
            {{set "prevMnth" mnth}}
        {{/each}}
    </div>
</script>
