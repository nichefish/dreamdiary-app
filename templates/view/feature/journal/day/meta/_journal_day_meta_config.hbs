<#--
 * 저널 일자(journal_day) 목록 조회 Template
 * @included_in : journal_day_page.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_day_meta_config_template">
    <span class="text-muted fs-4 pe-1">
        #
        <span class="text-dark fw-bold opacity-hover">
            {{#if (exists ctgr)}}
               <span class="fs-7 text-noti">[{{ctgr}}]</span>
            {{/if}}
            {{metaNm}}
        </span>
    </span>
    <div class="col-1 d-none d-md-flex border-2 border-gray-300 border-end h-75 me-3 w-10px">&nbsp;</div>
    <div class="gap-1">
        <button class="btn btn-sm btn-icon btn-outline btn-bg-light btn-active-color-primary"
                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.journal.day.meta.config-popup'/>">
            <i class="bi bi-gear"></i>
        </button>
        <button class="btn btn-sm btn-icon btn-outline btn-bg-light btn-active-color-primary"
                onclick="dF.JournalDayMeta.modal({{id}});"
                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "view.meta.content-list"/>">
            <i class="bi bi-bar-chart"></i>
        </button>
    </div>
</script>
