<#--
 * 저널 일자(journal_day) > 등록/수정 Template
 * @included_in : _journal_day_reg_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_day_reg_modal_template">
    <input type="hidden" name="id" value="{{id}}">

    <#--begin::Row-->
    <div class="row row-cols-lg-2 mb-3">
        <div class="col-xl-2 col-2 d-flex-center">
            <label class="fs-6 fw-bold mb-2 required" for="journalDate"><@spring.message 'txt.journal.day.field.date'/></label>
        </div>
        <div class="col-xl-3 col-5 d-flex flex-column" id="journalDateDiv">
            <div class="d-flex align-items-center mt-1">
                <span class="menu-icon me-md-2 vertical-middle">
                    <label for="journalDate"><i class="bi bi-calendar3 fs-2 cursor-pointer"></i></label>
                </span>
                <input type="text" name="journalDate" id="journalDate" class="form-control form-control-solid w-150px"
                       value="{{journalDate}}" placeholder="<@spring.message 'txt.journal.day.placeholder.journal-date'/>" maxlength="10" autocomplete="off" />
            </div>
            <div id="journalDate_validate_span"></div>
        </div>
        <div class="col-xl-2 col-5 d-flex flex-column align-items-start col-form-label">
            <div class="d-flex align-items-center gap-2">
                <label class="fs-6 fw-bold mb-0 required" for="journalDatePrecision"><@spring.message 'txt.journal.day.field.date-precision'/></label>
                <i class="bi bi-question-circle cursor-pointer"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                   title="<@spring.message 'bs.tooltip.journal.date-precision'/>"></i>
            </div>
        </div>
        <div class="col-xl-3 col-5 d-flex flex-column">
            <select name="journalDatePrecision" id="journalDatePrecision" class="form-select form-select-solid w-150px mt-1">
                <option value="EXACT">EXACT</option>
                <option value="APPROXIMATE">APPROXIMATE</option>
                <option value="UNKNOWN">UNKNOWN</option>
            </select>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row mb-3">
        <div class="col-2 text-center">
            <label for="weather" class="cursor-help col-form-label fs-6 fw-bold"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.journal.weather'/>">
                <@spring.message 'txt.journal.day.field.weather'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-1 d-flex-center w-5">
            <div id="weather_icon_div" class="cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                 title="<@spring.message 'bs.tooltip.journal.weather-preview'/>">
                {{#if (exists weather)}}
                    {{{weather}}}
                {{else}}
                    -
                {{/if}}
            </div>
        </div>
        <div class="col-8">
            <textarea name="weather" id="weather" class="form-control form-control-solid d-block"
                      placeholder="<@spring.message 'txt.journal.day.placeholder.weather'/>" maxlength="200" rows="1" >{{weather}}</textarea>
        </div>
        <div class="col-1 d-flex align-items-center">
            <div class="btn btn-sm btn-icon btn-light-primary"
                 onclick="dF.JournalDay.refreshIcon();"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.journal.weather-refresh-preview'/>">
                <i class="bi bi-arrow-repeat"></i>
            </div>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row d-flex mb-8">
        <div class="col-lg-12 col-3 d-flex align-items-center">
            <label class="text-gray-700 fs-6 fw-bolder cursor-help"
                   data-bs-toggle="tooltip" data-bs-placement="top" title="<@spring.message 'bs.tooltip.journal.diary-resolved'/>">
                <@spring.message 'txt.journal.day.diary-resolved-label'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-lg-2 col-9 d-flex align-items-center">
            <div class="form-check form-switch form-check-custom form-check-solid cursor-pointer">
                <input type="checkbox" name="diaryResolvedYn" id="diaryResolvedYn" class="form-check-input cursor-pointer"
                       value="Y" {{checkedYn diaryResolvedYn}} />
                <label class="form-check-label fw-bold fs-6 ms-3" for="diaryResolvedYn" id="diaryResolvedYnLabel" {{{checkedYnStyle diaryResolvedYn "color" "red//gray"}}}>
                    {{#ifYn diaryResolvedYn}}<@spring.message 'txt.status.completed'/>{{else}}<@spring.message 'txt.status.incomplete'/>{{/ifYn}}
                </label>
            </div>
        </div>
    </div>

    <!--begin::tagify partial-->
    <#include "/view/feature/attachable/tag/_tag_tagify_partial.hbs">
    <!--begin::tagify partial-->
    <#include "/view/feature/attachable/meta/_meta_tagify_partial.hbs">
</script>
