<#--
 * 저널 일자(journal_day) 목록 조회 Template
 * @included_in : journal_day_page.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_day_list_template">
    {{#each list}}
        <div class="journal-day" id="journal-day-{{stdrdDt}}" data-stdrd-dt="{{stdrdDt}}">
            <div class="journal-day-header" data-date="{{stdrdDt}}">
                <div class="col-12 col-md-1 d-flex flex-wrap align-items-center fs-5 fw-bold">
                    {{> journal_day_stdrd_dt_partial this}}
                </div>
                <div class="col-3 d-none d-md-flex align-items-center gap-2">
                    {{#if ../showDiaries}}
                        {{> journal_chapter_reg_btn_partial this}}
                    {{/if}}
                    {{#if ../showDreams}}
                        {{> journal_dream_reg_btn_partial this}}
                    {{/if}}
                    {{> journal_day_context_btn_partial this}}
                    {{> journal_day_meta_btn_partial this}}
                </div>
            </div>
            <div class="row">
                <div class="col-1 d-none d-md-flex"></div>
                <div class="col">
                    {{#if (exists tag.list)}}
                        <div class="ms-5 mt-3">
                            <i class="bi bi-tag"></i>
                            {{#tag.list}}
                                {{> tag_list_partial this module="dF.JournalDayTag"}}
                            {{/tag.list}}
                        </div>
                    {{/if}}
                </div>
            </div>
            <div class="journal-day-content row p-5">
                {{#if ../showDiaries}}
                    {{#if (exists hiddenChapterCtgrList)}}
                        <div class="d-flex align-items-center mb-3">
                            <div class="d-flex flex-wrap align-items-center gap-2 ps-1 ps-md-5">
                                <span class="badge badge-light-warning text-warning fw-semibold">CHAPTER FILTER</span>
                                <span class="text-muted fs-7">숨겨진 카테고리:</span>
                                {{#each hiddenChapterCtgrList}}
                                    <span class="badge badge-light-secondary text-muted">{{categoryName}} {{categoryCode}}</span>
                                {{/each}}
                            </div>
                        </div>
                    {{/if}}
                    {{#each journalChapterList}}
                        {{> journal_chapter_item_partial this}}
                    {{/each}}
                {{/if}}
                {{#if ../showDreams}}
                    {{#if hasDream}}
                        <div class="d-flex align-items-center mt-2">
                            <div class="col col-md-1 w-5 text-gray-700 fs-6 ps-1 ps-md-5 fw-bolder ">
                                <@spring.message 'txt.dream'/>
                                <i class="bi bi-moon-stars fs-4 pe-1"></i>
                            </div>
                        </div>
                    {{/if}}
                    {{#each journalDreamList}}
                        {{> journal_dream_item_partial this}}
                    {{/each}}
                    {{#each journalElseDreamList}}
                        {{> journal_dream_item_partial this}}
                    {{/each}}
                {{else}}
                    {{#if hasDream}}
                        <div class="d-flex align-items-center mt-2">
                            <div class="col ps-1 ps-md-5">
                                <span class="badge badge-light-secondary text-muted fw-normal">
                                    <i class="bi bi-moon-stars me-1"></i>
                                    꿈 숨김
                                </span>
                            </div>
                        </div>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    {{else}}
        <div class="journal-day d-flex-center">
            <@spring.message 'msg.rslt.empty'/>
        </div>
    {{/each}}
</script>
