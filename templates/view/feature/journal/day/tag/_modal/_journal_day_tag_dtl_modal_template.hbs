 <#--
 * 저널 일자 (journal_day) > 상세 Template
 * @included_in : _journal_day_tag_dtl_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_day_tag_dtl_modal_template">
    <div class="d-flex flex-column mb-4">
        <div class="d-flex justify-content-start align-items-center gap-3 mb-4">
            <label for="journal_day_tag_yy" class="form-label mb-0 fw-bold">년도</label>
            <select id="journal_day_tag_yy"
                    class="form-select form-select-sm w-auto"
                    onchange="dF.JournalDayTag.changeYy({{id}}, this.value);">
                {{#each yearOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
            </select>
        </div>
        {{#each list}}
            {{^if (equals this.mnth (lookup @root._locals "prevMnth"))}}
                <div class="d-flex-center mt-6 mb-4 fs-5 text-dark">
                    {{yy}}년 {{mnth}}월
                </div>
            {{/if}}

            <div class="journal-item">
                <div class="col-12 col-md-1 d-flex flex-wrap align-items-center fs-5 fw-bold">
                    {{> journal_day_stdrd_dt_partial this}}
                    {{> journal_day_context_btn_partial this id=this.journalDayId}}
                </div>
                <div class="col py-3 d-flex d-flex flex-column">
                    <div class="flex-row mb-2">
                        {{#if (exists tag.list)}}
                            <div class="ms-2">
                                {{#tag.list}}
                                    {{> tag_list_partial this module="dF.JournalDayTag"}}
                                {{/tag.list}}
                            </div>
                        {{/if}}
                    </div>
                    <div class="flex-row mb-2">
                        {{#if (exists comment.list)}}
                            <div class="row pb-2">
                                <div class="col-1 w-130px"></div>
                                <div class="col ms-10 text-noti">
                                    {{#each comment.list}}
                                        {{> comment_list_partial this}}
                                    {{/each}}
                                </div>
                            </div>
                        {{/if}}
                    </div>

                    <div class="flex-row">
                        {{#each journalChapterList}}
                            <div class="d-flex align-items-center mt-2">
                                <div class="col col-md-1 w-5 text-gray-700 fs-6 ps-1 ps-md-5 fw-bolder ">
                                    {{#ifYn chapterResolvedYn}}
                                        <span class="text-success"><@spring.message 'txt.chapter'/></span>
                                        <span class="position-relative d-inline-block">
                                          <i class="bi bi-book fs-4 text-success"></i>
                                        </span>
                                    {{else}}
                                        <@spring.message 'txt.chapter'/>
                                        <i class="bi bi-book fs-4 pe-1"></i>
                                    {{/ifYn}}
                                </div>
                                <div class="col-3 d-none d-md-flex align-items-center gap-2">
                                    {{> journal_diary_reg_btn_partial this}}
                                    {{> journal_chapter_context_btn_partial this}}
                                    {{> journal_chapter_toggle_btn_partial this}}
                                </div>
                            </div>
                            <div class="journal-chapter journal-item" data-id={{id}}>
                                {{#each journalDiaryList}}
                                    <div class="journal-diary-item" data-id={{id}} data-collapsed="{{collapsedYn}}" data-resolved="{{resolvedYn}}" data-imprtc="{{imprtcYn}}">
                                        <div class="col-1 py-3 d-none d-md-flex-between border-2 border-gray-300 border-end ps-5 me-4 h-75" style="width:85px;">
                                            <div class="d-flex flex-column align-items-center">
                                                <span class="journal-diary-idx {{#if (hasState state 'RESOLVED')}}text-success{{/if}}">
                                                    # {{idx}}
                                                </span>
                                                {{> journal_diary_toggle_btn_partial this}}
                                            </div>
                                        </div>
                                        <div class="col journal-diary-cn">
                                            {{> journal_diary_cn_partial this}}
                                        </div>
                                        <div class="col-1 ms-4 d-none d-md-flex border-2 border-gray-300 border-end h-75 w-10px">&nbsp;</div>
                                        <div class="col-1 py-3 d-none d-md-flex-between w-75px ps-2 gap-1">
                                            {{> comment_reg_btn_partial this contentType="JOURNAL_DIARY"}}
                                            {{> journal_diary_copy_btn_partial this}}
                                            {{> journal_diary_context_btn_partial this}}
                                        </div>
                                    </div>
                                {{/each}}
                            </div>
                        {{/each}}
                        {{#if hasDream}}
                            <div class="d-flex align-items-center mt-2">
                                <span class="text-gray-700 fs-6 ps-1 ps-md-5 fw-bolder">
                                    <@spring.message 'txt.dream'/>
                                    <i class="bi bi-moon-stars fs-4 pe-1"></i>
                                </span>
                            </div>
                            {{#each journalDreamList}}
                                <div class="journal-item">
                                    <div class="col-1 py-3 d-none d-md-flex-between border-2 border-gray-300 border-end ps-10 me-4 h-75" style="width:85px;">
                                        <div># {{idx}}</div>
                                    </div>
                                    <div class="col py-3 journal-dream-cn {{#if (hasState state 'IMPRTC')}}bg-secondary{{/if}}">
                                        {{> journal_dream_cn_partial this collapse="collapse-4"}}
                                    </div>
                                    <div class="col-1 bd-none d-md-flex order-2 border-gray-300 border-end h-75 w-10px">&nbsp;</div>
                                    <div class="col-1 py-3 d-none d-md-flex-between w-75px gap-1">
                                        {{> comment_reg_btn_partial this contentType="JOURNAL_DREAM"}}
                                        {{> journal_dream_copy_btn_partial this}}
                                        {{> journal_dream_context_btn_partial this}}
                                    </div>
                                </div>
                            {{/each}}
                            {{#each journalElseDreamList}}
                                <div class="journal-item">
                                    <div class="col-1 py-3 d-none d-md-flex border-2 border-gray-300 border-end ps-10 me-4 h-75" style="width:85px;">
                                        -
                                    </div>
                                    <div class="col py-3 journal-dream-cn bg-secondary">
                                        {{> journal_dream_cn_partial this collapse="collapse-4" elseDreamYn="Y"}}
                                    </div>
                                    <div class="col-1 d-none d-md-flex border-2 border-gray-300 border-end h-75 w-10px">&nbsp;</div>
                                    <div class="col-1 py-3 d-none d-md-flex-between w-75px gap-1">
                                        {{> comment_reg_btn_partial this contentType="JOURNAL_DREAM"}}
                                        {{> journal_dream_copy_btn_partial this}}
                                        {{> journal_dream_context_btn_partial this}}
                                    </div>
                                </div>
                            {{/each}}
                        {{/if}}
                    </div>
                </div>
                <div class="col-1 w-50px"></div>
            </div>

            {{set "prevMnth" this.mnth}}
        {{/each}}
    </div>
</script>
