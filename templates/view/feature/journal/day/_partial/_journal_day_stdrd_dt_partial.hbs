<#--
 * 저널 일자(journal_day) - 일자 partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_day_stdrd_dt_partial" data-partial>
    <div class="{{#if isHolyday}}text-danger{{/if}}" style="column-gap: .25rem">
        <i class="bi bi-calendar3 fs-6 me-1 {{#if isHolyday}}text-danger{{/if}}"></i>
        {{stdrdDt}}
        {{#ifYn dtUnknownYn}}
            <i class='bi bi-exclamation-circle cursor-pointer text-noti blink fs-7 ms-2'
               data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="불확실한 일자입니다."></i>
        {{else}}
            <span class="fs-8 {{#if isHolyday}}text-danger{{else}}text-gray-600{{/if}}">({{journalDtWeekDay}})</span>
        {{/ifYn}}
        <span class="fs-7 ms-4 text-muted">{{{weather}}}</span>
        {{#if (exists holydayNm)}}<div class="w-100 ps-5 fs-6 fw-normal text-truncate">{{holydayNm}}</div>{{/if}}
    </div>
</script>
