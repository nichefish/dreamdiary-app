<#--
 * journal_entry > register/modify modal header template
 * @included_in : _journal_entry_reg_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="${entryRegHeaderTemplateId}_template">
    <input type="hidden" name="id" value="{{id}}">
    <#if entryRegUseLegacyStateHidden!false>
        <input type="hidden" name="resolvedYn" value="{{resolvedYn}}">
        <input type="hidden" name="collapsedYn" value="{{collapsedYn}}">
        <input type="hidden" name="imprtcYn" value="{{imprtcYn}}">
    </#if>

    <div class="row d-flex mb-8">
        <div class="col-2">
            <label class="d-flex align-items-center mb-2" for="title">
                <span class="text-gray-700 fs-6 fw-bolder"><@spring.message "txt.journal.day"/></span>
            </label>
        </div>
        <div class="col-2 fs-6">
            <i class="bi bi-calendar3"></i>
            {{stdrdDt}}
            {{#if (exists journalDateWeekDay)}}
                <span class="fs-8 text-gray-600">({{journalDateWeekDay}})</span>
            {{/if}}
        </div>
    </div>
    <div class="row d-flex mb-8">
        <div class="col-12">
            <label class="d-flex align-items-center mb-2" for="title">
                <span class="text-gray-700 fs-6 fw-bolder"><@spring.message 'txt.title'/></span>
                <span class="text-gray-500 fs-9"><@spring.message 'txt.journal.field.title-max-50'/></span>
            </label>
        </div>
        <div class="col-lg-${entryRegChapterCol!1}">
            <select name="journalChapterId" id="journalChapterId" class="form-select form-select-solid">
                {{#each chapterList}}
                    <option value="{{id}}" {{selectedIf (equals id ../journalChapterId)}}>{{sortOrder}} {{title}}</option>
                {{/each}}
            </select>
        </div>
        <#if entryRegShowCategorySelect!false>
            <div class="col-lg-2">
                <select name="ctgrCd" id="ctgrCd" class="form-select form-select-solid">
                    <option value=""><@spring.message 'txt.journal.select.post-ctgr'/></option>
                </select>
            </div>
        </#if>
        <div class="col-lg-{{#if (exists id)}}${entryRegTitleColEdit!10}{{else}}${entryRegTitleColNew!11}{{/if}}">
            <input type="text" name="title" id="title" class="form-control"
                   value="{{title}}" placeholder="<@spring.message 'txt.title'/>" maxlength="100" />
            <div id="title_validate_span"></div>
        </div>
        {{#if (exists id)}}
            <#if entryRegHideSortForElseDream!false>
                {{^ifYn elseDreamYn}}
                    <div class="col-1 d-flex ps-0">
                        <div class="d-flex-center p-2 fw-bold fs-5 text-gray-600">#</div>
                        <input type="number" class="form-control form-control-sm" name="sortOrder" id="sortOrder" min="1" max="99"
                               maxlength="${entryRegSortMaxLength!3}" value="{{sortOrder}}" placeholder="<@spring.message 'txt.journal.field.sort-order.placeholder'/>"
                               data-bs-toggle="tooltip" data-bs-placement="top" title="<@spring.message entryRegSortTooltipKey/>">
                    </div>
                {{/ifYn}}
            <#else>
                <div class="col-1 d-flex ps-0">
                    <div class="d-flex-center p-2 fw-bold fs-5 text-gray-600">#</div>
                    <input type="number" class="form-control form-control-sm" name="sortOrder" id="sortOrder" min="1" max="99"
                           value="{{sortOrder}}" placeholder="<@spring.message 'txt.journal.field.sort-order.placeholder'/>" maxlength="${entryRegSortMaxLength!3}"
                           data-bs-toggle="tooltip" data-bs-placement="top" title="<@spring.message entryRegSortTooltipKey/>">
                </div>
            </#if>
        {{/if}}
    </div>
</script>
