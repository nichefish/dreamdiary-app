<#--
 * journal_entry - registration button partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_entry_reg_btn_partial" data-partial>
    <button type="button" class="btn btn-sm btn-light-primary btn-outlined ps-4 pe-3 py-2 cursor-pointer"
            onclick="{{module}}.regModal({ journalDayId: {{#if (exists dayIdParam)}}{{dayIdParam}}{{else}}{{journalDayId}}{{/if}}{{#if (exists chapterIdParam)}}, journalChapterId: {{chapterIdParam}}{{/if}}, stdrdDt: '{{stdrdDt}}', journalDateWeekDay: '{{journalDateWeekDay}}' });"
            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="{{tooltipLabel}} <@spring.message "bs.tooltip.modal.reg"/>">
        <i class="bi {{iconClass}} fs-4 pe-1"></i>
        {{buttonLabel}}
    </button>
</script>

<script type="text/x-handlebars-template" id="journal_entry_reg_btn_by_type_partial" data-partial>
    {{#if (equals contentType "JOURNAL_DIARY")}}
        {{> journal_entry_reg_btn_partial this module="dF.JournalEntry.get('JOURNAL_DIARY')" iconClass="bi-book" tooltipLabel="<@spring.message 'txt.journal.diary'/>" buttonLabel="<@spring.message 'txt.journal.diary.reg'/>" dayIdParam=dayIdParam chapterIdParam=chapterIdParam}}
    {{else}}
        {{> journal_entry_reg_btn_partial this module="dF.JournalEntry.get('JOURNAL_DREAM')" iconClass="bi-moon-stars" tooltipLabel="<@spring.message 'txt.journal.dream'/>" buttonLabel="<@spring.message 'txt.journal.dream.reg'/>" dayIdParam=dayIdParam chapterIdParam=chapterIdParam}}
    {{/if}}
</script>
