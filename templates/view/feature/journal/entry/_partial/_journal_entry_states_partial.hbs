<#--
 * journal_entry > states partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_entry_states_partial" data-partial>
    <div class="d-flex journal-{{cssPrefix}}-states ms-2 mb-1 gap-1">
        <div class="d-flex-align-center title-wrap">
            {{#if showDreamStates}}
                <div class="dream-nhtmr-badge ctgr-span ctgr-info w-auto {{#unless (hasState state 'NHTMR')}}d-none{{/unless}}">!<@spring.message 'txt.dream.nhtmr'/></div>
                <div class="dream-halluc-badge ctgr-span ctgr-gray w-auto {{#unless (hasState state 'HALLUC')}}d-none{{/unless}}">!<@spring.message 'txt.dream.halluc'/></div>
                {{#ifYn elseDreamYn}}<div class="ctgr-span ctgr-gray w-70px d-flex-center">({{elseDreamerNm}} <@spring.message 'txt.dream'/>)</div>{{/ifYn}}
            {{/if}}
            {{#if (exists title)}}<div class="d-inline-block fw-bold">{{title}}</div>{{/if}}
        </div>
    </div>
</script>
