<#--
 * journal_entry - context menu partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_entry_context_btn_partial" data-partial>
    <div class="me-0 d-flex align-items-center">
        <button class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary"
                data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"
                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.context.menu.show'/>">
            <i class="ki-solid ki-dots-horizontal fs-2x"></i>
        </button>
        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
            <div class="menu-item px-3">
                <div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">{{contentLabel}}</div>
            </div>

            {{#if showDayOpen}}
                <div class="menu-item px-3 my-1 cursor-pointer"
                     data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.day"/> <@spring.message 'bs.tooltip.modal.mdf'/>">
                    <div class="menu-link flex-stack px-3" onclick="dF.JournalDay.openDetatched('{{stdrdDt}}');">
                        <@spring.message "txt.comm.open-in-new-window"/>
                        <i class="bi bi-window-stack fs-8"></i>
                    </div>
                </div>
                <div class="separator my-2"></div>
            {{/if}}

            {{#if showInterpretation}}
                <div class="menu-item px-3 my-1 cursor-pointer"
                     data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "txt.journal.interpretation"/> <@spring.message 'bs.tooltip.modal.reg'/>">
                    <div class="menu-link flex-stack px-3"
                         onclick="dF.JournalInterpretation.regModal({ journalDayId: {{journalDayId}}, refId: {{id}}, refContentType: '{{contentType}}', stdrdDt: '{{stdrdDt}}', journalDateWeekDay: '{{journalDateWeekDay}}' });">
                        <@spring.message 'txt.journal.interpretation.reg'/>
                        <i class="bi bi-layers-half fs-8"></i>
                    </div>
                </div>
                <div class="separator my-2"></div>
            {{/if}}

            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="{{contentLabel}} <@spring.message 'bs.tooltip.modal.mdf'/>">
                <div class="menu-link flex-stack px-3" onclick="{{module}}.mdfModal({{id}}, '{{stdrdDt}}');">
                    <@spring.message 'txt.comm.edit'/>
                    <i class="bi bi-pencil-square fs-8"></i>
                </div>
            </div>
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                 title="{{#if (exists history.historyTriggeredAt)}}<@spring.message 'txt.history'/>{{else}}<@spring.message 'txt.history.empty'/>{{/if}}">
                <div class="menu-link flex-stack px-3 {{#unless (exists history.historyTriggeredAt)}}disabled text-muted{{/unless}}"
                     {{#if (exists history.historyTriggeredAt)}}onclick="dF.History.modal.open('{{contentType}}', {{id}});"{{/if}}>
                    <@spring.message 'txt.history'/>
                    <i class="bi bi-clock-history fs-8"></i>
                </div>
            </div>

            {{#if showRelated}}
                {{^ifYn elseDreamYn}}
                    <div class="menu-item px-3 my-1 cursor-pointer"
                         data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.related-content.add'/>">
                        <div class="menu-link flex-stack px-3" onclick="dF.RelatedContent.openAddModalBySource('{{contentType}}', {{id}});">
                            <@spring.message 'txt.related-content.add'/>
                            <i class="bi bi-link-45deg fs-8"></i>
                        </div>
                    </div>
                {{/ifYn}}
            {{/if}}

            <div class="separator my-2"></div>
            <div class="menu-item px-3" data-kt-menu-trigger="hover" data-kt-menu-placement="right-end">
                <a href="#" class="menu-link px-3">
                    <span class="menu-title"><@spring.message 'txt.lifecycle'/></span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="menu-sub menu-sub-dropdown w-175px py-4">
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-check-custom form-check-solid cursor-pointer">
                                <input class="form-check-input w-18px h-18px cursor-pointer {{cssPrefix}}-context-lifecycle-check" type="radio" name="{{cssPrefix}}-lifecycle-{{id}}" value="OPEN" {{#if (equals lifecycle.lifecycleKey 'OPEN')}}checked="checked"{{/if}}
                                       onclick="{{module}}.setLifecycleAjax({{id}}, 'OPEN');">
                                <span class="form-check-label fs-7 {{#if (equals lifecycle.lifecycleKey 'OPEN')}}text-gray-800{{else}}text-muted{{/if}}"><@spring.message 'txt.lifecycle.open'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-check-custom form-check-solid cursor-pointer">
                                <input class="form-check-input w-18px h-18px cursor-pointer {{cssPrefix}}-context-lifecycle-check" type="radio" name="{{cssPrefix}}-lifecycle-{{id}}" value="PENDING" {{#if (equals lifecycle.lifecycleKey 'PENDING')}}checked="checked"{{/if}}
                                       onclick="{{module}}.setLifecycleAjax({{id}}, 'PENDING');">
                                <span class="form-check-label fs-7 {{#if (equals lifecycle.lifecycleKey 'PENDING')}}text-primary{{else}}text-muted{{/if}}"><@spring.message 'txt.lifecycle.pending'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-check-custom form-check-solid cursor-pointer">
                                <input class="form-check-input w-18px h-18px cursor-pointer {{cssPrefix}}-context-lifecycle-check {{cssPrefix}}-context-resolved-check" type="radio" name="{{cssPrefix}}-lifecycle-{{id}}" value="RESOLVED" {{#if (equals lifecycle.lifecycleKey 'RESOLVED')}}checked="checked"{{/if}}
                                       onclick="{{module}}.setLifecycleAjax({{id}}, 'RESOLVED');">
                                <span class="form-check-label fs-7 {{#if (equals lifecycle.lifecycleKey 'RESOLVED')}}text-success{{else}}text-muted{{/if}}"><@spring.message 'txt.status.resolved'/></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="separator my-2"></div>
            <div class="menu-item px-3" data-kt-menu-trigger="hover" data-kt-menu-placement="right-end">
                <a href="#" class="menu-link px-3">
                    <span class="menu-title"><@spring.message 'txt.comm.status'/></span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="menu-sub menu-sub-dropdown w-175px py-4">
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.status.imprtc'/>">
                                <input class="form-check-input w-30px h-20px cursor-pointer {{cssPrefix}}-context-imprtc-check" type="checkbox" value="1" {{#if (hasState state 'IMPRTC')}}checked="checked"{{/if}}
                                       onclick="{{module}}.imprtcAjax({{id}});">
                                <span class="form-check-label fs-7 {{#if (hasState state 'IMPRTC')}}text-danger{{else}}text-muted{{/if}}"><@spring.message 'txt.status.imprtc'/></span>
                            </label>
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.status.refrnc'/>">
                                <input class="form-check-input w-30px h-20px cursor-pointer {{cssPrefix}}-context-refrnc-check" type="checkbox" value="1" {{#if (hasState state 'REFRNC')}}checked="checked"{{/if}}
                                       onclick="{{module}}.refrncAjax({{id}});">
                                <span class="form-check-label fs-7 {{#if (hasState state 'REFRNC')}}text-warning{{else}}text-muted{{/if}}"><@spring.message 'txt.status.refrnc'/></span>
                            </label>
                        </div>
                    </div>

                    {{#if showDreamStates}}
                        <div class="menu-item px-3">
                            <div class="menu-content px-3">
                                <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                       data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.dream.nhtmr'/>">
                                    <input class="form-check-input w-30px h-20px cursor-pointer dream-context-nhtmr-check" type="checkbox" value="1" {{#if (hasState state 'NHTMR')}}checked="checked"{{/if}}
                                           onclick="dF.JournalEntry.get('JOURNAL_DREAM').nhtmrAjax({{id}});">
                                    <span class="form-check-label fs-7 {{#if (hasState state 'NHTMR')}}text-info{{else}}text-muted{{/if}}"><@spring.message 'txt.dream.nhtmr'/></span>
                                </label>
                            </div>
                        </div>
                        <div class="menu-item px-3">
                            <div class="menu-content px-3">
                                <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                       data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.dream.halluc'/>">
                                    <input class="form-check-input w-30px h-20px cursor-pointer dream-context-halluc-check" type="checkbox" value="1" {{#if (hasState state 'HALLUC')}}checked="checked"{{/if}}
                                           onclick="dF.JournalEntry.get('JOURNAL_DREAM').hallucAjax({{id}});">
                                    <span class="form-check-label fs-7 {{#if (hasState state 'HALLUC')}}text-gray-700{{else}}text-muted{{/if}}"><@spring.message 'txt.dream.halluc'/></span>
                                </label>
                            </div>
                        </div>
                    {{/if}}

                    <div class="menu-item px-3">
                        <div class="menu-content px-3">
                            <label class="form-check form-switch form-check-custom form-check-solid cursor-pointer"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.status.collapsed'/>">
                                <input class="form-check-input w-30px h-20px cursor-pointer {{cssPrefix}}-context-collapsed-check" type="checkbox" value="1" {{#if (hasState state 'COLLAPSED')}}checked="checked"{{/if}}
                                       onclick="{{module}}.collapseAjax({{id}});">
                                <span class="form-check-label fs-7 {{#if (hasState state 'COLLAPSED')}}text-gray-700{{else}}text-muted{{/if}}"><@spring.message 'txt.status.collapsed'/></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="separator my-2"></div>
            <div class="menu-item px-3 my-1 cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="{{contentLabel}} <@spring.message 'bs.tooltip.del'/>">
                <div class="menu-link flex-stack px-3 text-danger" onclick="{{module}}.delAjax({{id}});">
                    <@spring.message 'txt.comm.del'/>
                    <i class="bi bi-trash text-danger p-0 fs-8"></i>
                </div>
            </div>
        </div>
    </div>
</script>

<script type="text/x-handlebars-template" id="journal_entry_context_btn_by_type_partial" data-partial>
    {{#if (equals contentType "JOURNAL_DIARY")}}
        {{> journal_entry_context_btn_partial this module="dF.JournalEntry.get('JOURNAL_DIARY')" contentType="JOURNAL_DIARY" contentLabel="<@spring.message 'txt.journal.diary'/>" cssPrefix="diary" showInterpretation=showInterpretation showRelated=showRelated showDayOpen=showDayOpen}}
    {{else}}
        {{> journal_entry_context_btn_partial this module="dF.JournalEntry.get('JOURNAL_DREAM')" contentType="JOURNAL_DREAM" contentLabel="<@spring.message 'txt.journal.dream'/>" cssPrefix="dream" showInterpretation=showInterpretation showRelated=showRelated showDayOpen=showDayOpen showDreamStates=true}}
        {{! NOTE: context button by type not needed since NOTE entries use JOURNAL_DIARY type }}
    {{/if}}
</script>
