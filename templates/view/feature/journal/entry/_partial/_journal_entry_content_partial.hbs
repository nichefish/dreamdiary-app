<#--
 * journal_entry - content partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_entry_content_partial" data-partial>
    <div class="{{#if (exists contentClass)}}{{contentClass}}{{else}}journal-content {{contentStateClass state}}{{#if (exists collapse)}}{{#if (hasState state 'COLLAPSED')}} {{collapse}}{{/if}}{{/if}}{{/if}}">
        {{{markdownContent}}}
    </div>
    <button type="button" class="btn btn-xxs btn-active-light-info badge-light-primary btn-outlined expand-btn"
            onclick="dF.JournalDayTag.expand(this);">
    </button>

    {{#if (exists tag.list)}}
        <div class="tags ms-2 mt-3">
            <i class="bi bi-tag"></i>
        {{#tag.list}}
            {{> tag_list_partial this module=tagModule}}
        {{/tag.list}}
        </div>
    {{/if}}
    {{#if (exists id)}}
        {{^ifYn elseDreamYn}}
            <div class="related-content-anchor"
                 data-post-no="{{id}}"
                 data-content-type="{{contentType}}"></div>
            {{#if relatedContentList.length}}
                <div class="related-content-box mt-4 pt-4 border-top border-gray-200"
                     data-post-no="{{id}}"
                     data-content-type="{{contentType}}">
                    <div class="d-flex align-items-center gap-2 mb-3 text-gray-700">
                        <i class="bi bi-link-45deg"></i>
                        <span class="fw-semibold"><@spring.message 'txt.related-content'/></span>
                    </div>
                    <div class="related-content-list">
                        {{#each relatedContentList}}
                            <div class="related-content-item rounded border border-gray-300 bg-light px-4 py-3 mb-3"
                                 data-related-content-id="{{id}}">
                                <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                                    <div class="flex-grow-1">
                                        <div class="text-muted fs-8 mb-2">{{targetContentType}} <span>#</span>{{targetPostNo}}</div>
                                        <div class="fw-semibold text-gray-900 fs-6">{{targetTitle}}</div>
                                        {{#if reason}}
                                            <div class="text-muted fs-7 mt-2">{{reason}}</div>
                                        {{/if}}
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-xxs btn-light-primary btn-outlined"
                                                onclick="dF.RelatedContent.openTarget('{{targetContentType}}', {{targetPostNo}});"><@spring.message 'txt.comm.open'/></button>
                                        <button type="button" class="btn btn-xxs btn-light-danger btn-outlined"
                                                onclick="dF.RelatedContent.deleteAjax({{id}}, this);"><@spring.message 'txt.comm.del'/></button>
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            {{/if}}
        {{/ifYn}}
    {{/if}}
    {{#if (exists comment.list)}}
        {{#each comment.list}}
            {{> comment_list_partial this}}
        {{/each}}
    {{/if}}
</script>

<script type="text/x-handlebars-template" id="journal_entry_content_by_type_partial" data-partial>
    {{#if (equals contentType "JOURNAL_DIARY")}}
        {{> journal_entry_content_partial this contentType="JOURNAL_DIARY" tagModule="dF.JournalEntryTag.get('JOURNAL_DIARY')" collapse=collapse elseDreamYn=elseDreamYn}}
    {{else}}
        {{> journal_entry_content_partial this contentType="JOURNAL_DREAM" tagModule="dF.JournalEntryTag.get('JOURNAL_DREAM')" collapse=collapse elseDreamYn=elseDreamYn}}
    {{/if}}
</script>
