<#--
 * journal_entry - copy button partial
 * @see handlebars.ts
 -->

<script type="text/x-handlebars-template" id="journal_entry_copy_btn_partial" data-partial>
    <button type="button" class="btn btn-sm btn-light-primary btn-outlined m-1 py-0 px-2 cursor-pointer"
            onclick="{{module}}.copy({{id}});"
            data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "bs.tooltip.copy"/>">
        <i class="bi bi-copy p-0"></i>
    </button>
</script>

<script type="text/x-handlebars-template" id="journal_entry_copy_btn_by_type_partial" data-partial>
    {{#if (equals contentType "JOURNAL_DIARY")}}
        {{> journal_entry_copy_btn_partial this module="dF.JournalEntry.get('JOURNAL_DIARY')"}}
    {{else}}
        {{> journal_entry_copy_btn_partial this module="dF.JournalEntry.get('JOURNAL_DREAM')"}}
    {{/if}}
</script>
