<#--
 * 저널 태그(journal_tag) > 그룹별 목록 Template
 * @included_in : _journal_tag_list_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_tag_group_list_template">
    <div id="ctgr_{{ctgr}}">
        {{#each tagList}}
            <span class="py-2 me-3 cursor-pointer opacity-hover"
                  onclick="dF.JournalDreamTag.dtlModal({{id}}, '{{tagNm}}');"
                  data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.journal.tag.filter-by-tag'/>">
                <span class="{{tagClass}} {{textClass}}">
                    {{#if (exists ctgr)}}
                        <span class="fs-7 text-noti">[{{ctgr}}]</span>
                    {{/if}}
                {{tagNm}}
                </span>
                <span class="fs-9 text-noti fw-normal" style="margin-left:-0.25em;">{{contentSize}}</span>
            </span>
        {{/each}}
    </div>
</script>
