<#--
 * 저널 일기(journal_diary) 목록 조회 Template
 * @included_in : journal_day_page.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_todo_list_template">
    {{#each this}}
        <div class="row d-flex-align-center justify-content-between">
            <div class="col text-truncate cursor-pointer"
'                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                 title="{{title}}">
                {{title}}
            </div>
            <div class="col-3 d-flex justify-content-end">
                <button type="button" class="btn btn-sm btn-light-danger btn-outlined py-2 px-3 cursor-pointer"
                        onclick="dF.JournalTodo.delAjax({{id}});"
                        data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'txt.journal.day'/> <@spring.message 'bs.tooltip.modal.mdf'/>">
                    <i class="bi bi-trash p-0"></i>
                </button>
            </div>
        </div>
    {{else}}
        <div class="journal-day d-flex-center">
            할일이 없습니다.
        </div>
    {{/each}}
</script>
