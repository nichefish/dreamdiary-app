<#--
 * 저널 해석(journal_intrpt) > 태그 상세 Template
 * @included_in : _journal_intrpt_tag_dtl_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="journal_intrpt_tag_dtl_modal_template">
    {{#each this}}
        {{^if (equals this.mnth (lookup @root._locals "prevMnth"))}}
            <div class="d-flex-center mt-6 mb-4 fs-5 text-dark">{{yy}}년 {{mnth}}월</div>
        {{/if}}

        <div class="journal-item">
            <div class="col-1 d-none d-md-flex-align-center py-3 border-2 border-gray-300 border-end me-4 w-130px h-75 gap-2">
                {{> journal_day_context_btn_partial this id=this.journalDayId}}
            </div>
            <div class="col py-3 journal-intrpt-cn {{#if (hasState state 'IMPRTC')}}bg-secondary{{/if}}">
                {{> journal_intrpt_cn_partial this collapse="collapse-4"}}
            </div>
            <div class="col-1 d-none d-md-flexborder-2 border-gray-300 border-end h-75 w-10px">&nbsp;</div>
            <div class="col-1 py-3 d-none d-md-flex-between w-125px gap-1">
                {{> comment_reg_btn_partial this contentType="JOURNAL_INTRPT"}}
                {{> journal_intrpt_copy_btn_partial this}}
                {{> journal_intrpt_context_btn_partial this}}
            </div>
        </div>

        {{!-- 현재 월을 previousMnth 변수로 저장 --}}
        {{set "prevMnth" this.mnth}}
    {{/each}}
</script>
