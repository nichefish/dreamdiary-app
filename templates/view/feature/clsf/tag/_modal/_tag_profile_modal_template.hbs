<#--
 * tag profile modal template
 -->

<script type="text/x-handlebars-template" id="tag_profile_modal_template">
    <form id="tagProfileForm" method="post">
        <input type="hidden" name="tagProfileNo" value="{{tagProfileNo}}">
        <input type="hidden" name="tagNo" value="{{tagNo}}">
        <input type="hidden" name="contentType" value="{{contentType}}">

        <div class="d-flex align-items-center gap-2 mb-4">
            <span class="badge badge-light-primary">{{contentTypeLabel}}</span>
            <span class="fs-6 fw-bold text-primary"># {{tagNm}}</span>
        </div>

        <div class="mb-4">
            <label for="tagTextClassCd" class="form-label fw-bold">태그클라우드 표시 색상</label>
            <select id="tagTextClassCd" name="textClassCd" class="form-select form-select-solid">
                <#list TEXT_CLASS_CD![] as item>
                    <option value="${item.dtlCd!}"
                            data-text-class="${item.dc!}"
                            class="${item.dc!}"
                            {{#if (equals textClassCd "${item.dtlCd!}")}}selected{{/if}}>
                        ${item.dtlCdNm!}
                    </option>
                </#list>
            </select>
        </div>

        <label for="tagProfileCn" class="form-label fw-bold">프로필</label>
        <textarea id="tagProfileCn" name="cn" class="form-control" rows="10"
                  placeholder="이 태그가 각 콘텐츠 타입에서 어떤 의미인지 메모합니다.">{{cn}}</textarea>
    </form>
</script>
