<#--
 * 댓글 목록 partial
 * @see handlebars.ts
-->

<script type="text/x-handlebars-template" id="comment_list_partial" data-partial>
    <div class="row {{#if @first}}mt-2{{/if}} {{#if @last}}mb-1{{/if}} d-flex-align-center">
        <div class="col d-flex-align-center position-relative ms-4">
            <div class="li text-comment">{{{markdownContent}}}</div>
        </div>
        <div class="col-1">
            <button type="button" class="btn btn-sm btn-light-primary btn-outlined py-1 px-2 cursor-pointer"
                    onclick="dF.Comment.modal.mdfModal({{id}});"
                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                    title="<@spring.message 'txt.comment'/> <@spring.message 'bs.tooltip.modal.mdf'/>">
                <i class="bi bi-pencil-square p-0"></i>
            </button>
            <button type="button" class="btn btn-sm btn-light-danger btn-outlined py-1 px-2 cursor-pointer"
                    onclick="dF.Comment.modal.delAjax({{id}});"
                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                    title="<@spring.message 'txt.comment'/> <@spring.message 'bs.tooltip.del'/>">
                <i class="bi bi-trash p-0"></i>
            </button>
        </div>
    </div>
</script>
