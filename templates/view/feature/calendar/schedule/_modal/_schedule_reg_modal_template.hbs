<#--
 * 일정 > 전체 일정 > 일정 등록 Template
 * @included_in : schedule_cal
 -->

<script type="text/x-handlebars-template" id="schedule_reg_modal_template">
    <input type="hidden" name="id" id="id" value="{{id}}">
    <input type="hidden" name="privateYn" id="privateYn" value="{{#if isPrvt}}Y{{else}}N{{/if}}">

    <#--begin::Row-->
    <div class="row mb-3">
        <div class="col-xl-2 col-2">
            <label class="col-form-label text-center fs-6 fw-bold required"><@spring.message 'txt.calendar.schedule.form.title'/></label>
        </div>
        <div class="col-xl-3 col-4">
            <select name="scheduleCd" id="scheduleCd" class="form-select form-select-solid required"
                    onchange="dF.Schedule.scheduleCd(this);">
                <option value=""><@spring.message 'txt.calendar.schedule.form.type-option'/></option>
                <#list SCHEDULE_CD![] as topic>
                    {{#if isPrvt}}
                        {{#unless (equals "${topic.code!}" "HOLYDAY")}}
                            {{#unless (equals "${topic.code!}" "CEREMONY")}}
                                {{#unless (equals "${topic.code!}" "TLCMMT")}}
                                    <option value="${topic.code!}" {{selectedIf (equals scheduleCd "${topic.code!}")}} >[${topic.codeName!}]</option>
                                {{/unless}}
                            {{/unless}}
                        {{/unless}}
                    {{else}}
                        <option value="${topic.code!}" {{selectedIf (equals scheduleCd "${topic.code!}")}} >[${topic.codeName!}]</option>
                    {{/if}}
                </#list>
            </select>
            <span id="scheduleCd_validate_span"></span>
        </div>
        <div class="col-xl-7 col-6">
            <input type="text" name="title" id="title" class="form-control form-control-solid required"
                   value="{{title}}" placeholder="<@spring.message 'txt.calendar.schedule.form.title'/>" maxlength="120" />
            <span id="title_validate_span"></span>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row mb-3">
        <div class="col-xl-2 col-2 d-flex align-items-center justify-content-between">
            <label class="col-form-label text-center fs-6 fw-bold" for="prtcpnt">
                <@spring.message 'txt.calendar.schedule.form.participants'/>
            </label>
            <span class="btn btn-sm btn-icon btn-light-primary" onclick="dF.Schedule.addPrtcpnt();">
                <i class="fas fa-plus float-end"></i>
            </span>
        </div>
        {{#if isPrvt}}
            <div class="col-xl-10 col-10 d-flex align-items-center">
                <div class="text-noti fs-small"><@spring.message 'txt.calendar.schedule.form.participants-guide'/></div>
            </div>
            <div class="col-xl-2 col-2"></div>
        {{/if}}
        <div class="col-xl-10 col-10" id="schedule_reg_prtcpnt_div">
            {{#prtcpntList}}
                <div id="prtcpntRow{{@index}}" class="d-flex align-items-center mb-1">
                    <select name="prtcpntList[{{@index}}].username" class="form-select form-select-solid me-2">
                        <option value=""><@spring.message 'txt.calendar.schedule.form.select-option'/></option>
                        <#list crtdUserList![] as user>
                            <option value="${user.username!}" id="${user.username!}" {{selectedIf (equals username "${user.username}")}}>${user.userNm!}</option>
                        </#list>
                    </select>
                    <span class="btn btn-sm btn-icon btn-light-danger" onclick="dF.Schedule.removePrtcpnt({{@index}});">
                        <i class="fas fa-trash float-end"></i>
                    </span>
                </div>
            {{/prtcpntList}}
            <#--handlebars template goes in here-->
        </div>
    </div>
    <#--begin::Row-->
    <div class="row mb-3">
        <div class="col-xl-2 col-2">
            <label class="col-form-label text-center fs-6 fw-bold mb-2" for="content"><@spring.message 'txt.calendar.schedule.form.content'/></label>
        </div>
        <div class="col-xl-10 col-10">
            <textarea name="content" id="content" class="form-control form-control-solid h-100px"
                      wrap="hard" maxlength="500">{{content}}</textarea>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row row-cols-lg-2 mb-3">
        <div class="col-xl-2 col-2">
            <label class="col-form-label text-center fs-6 fw-bold mb-2" for="scheduleResn"><@spring.message 'txt.calendar.schedule.form.period'/></label>
        </div>
        <div class="col-xl-5 col-5">
            <label class="fs-6 mt-3 mb-2 required" for="bgnDt"><@spring.message 'txt.calendar.schedule.form.start-date'/></label>
            <input name="bgnDt" id="bgnDt" class="form-control form-control-solid required"
                   value="{{bgnDt}}" placeholder="<@spring.message 'txt.calendar.schedule.form.start-date'/>" readonly/>
            <div id="bgnDt_validate_span"></div>
        </div>
        <div class="col-xl-5 col-5" id="endDtDiv">
            <label class="fs-6 mt-3 mb-2" for="endDt"><@spring.message 'txt.calendar.schedule.form.end-date'/></label>
            <input name="endDt" id="endDt" class="form-control form-control-solid"
                   value="{{endDt}}" placeholder="<@spring.message 'txt.calendar.schedule.form.end-date'/>" readonly />
            <div id="endDtSpan" class="text-noti"><@spring.message 'txt.calendar.schedule.form.end-date-guide'/></div>
        </div>
    </div>
    {{^if isPrvt}}
        <#--페이지:: 잔디 알림 발송 영역-->
        <@component.jandi_reg_area 2 "SCHEDULE" />
    {{/if}}
</script>


