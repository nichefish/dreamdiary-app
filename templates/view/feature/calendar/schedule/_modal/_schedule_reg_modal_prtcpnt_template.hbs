<#--
 * 일정 > 전체 일정 > 일정 등록 Template
 * @included_in : schedule_cal
 -->

<script type="text/x-handlebars-template" id="schedule_reg_modal_prtcpnt_template">
    <div id="prtcpntRow{{idx}}" class="d-flex align-items-center mb-1">
        <select name="prtcpntList[{{idx}}].username" class="form-select form-select-solid me-2">
            <option value=""><@spring.message 'txt.calendar.schedule.form.select-option'/></option>
            <#list crtdUserList![] as user>
                <option value="${user.username!}" id="${user.username!}">${user.userNm!}</option>
            </#list>
        </select>
        <span class="btn btn-sm btn-icon btn-light-danger" onclick="dF.Schedule.removePrtcpnt({{idx}});">
            <i class="fas fa-trash float-end"></i>
        </span>
    </div>
</script>
