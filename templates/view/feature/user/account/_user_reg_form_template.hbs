<#--
 * 사용자 등록/수정 화면 본문 템플릿 (Handlebars)
 * @included_in : user_regist_form.ftlh
 -->

<script type="text/x-handlebars-template" id="user_reg_form_template">
    <div class="card post">
        <#--begin::Card body-->
        <div class="card-body">
            <#--begin::Form-->
            <form name="userRegForm" id="userRegForm" class="form mt-10" data-mode="${formMode!}" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" value="${user.id!}">
                <input type="hidden" name="fileGroupId" value="${user.fileGroupId!}">
                <#--begin::Row-->
                <div class="row mb-4">
                    <div class="col-xl-2">
                        <div class="fw-bold col-form-label text-lg-center text-sm-end <#if isReg!false>required</#if>">
                            <label for="username"><@spring.message 'txt.user.form.username'/></label>
                        </div>
                    </div>
                    <#if isReg!false>
                        <div class="col-xl-2 col-8">
                            <input type="text" name="username" id="username" class="form-control form-control-solid required no-space"
                                   value="${user.username!}" maxlength="16" />
                            <div class="form-text">
                                <@spring.message 'txt.req.username'/>
                            </div>
                            <div id="username_validate_span" class="text-danger"></div>
                            <div id="ipDupChckPassed_validate_span" class="text-danger"></div>
                        </div>
                        <div class="col-xl-2 col-4">
                            <button type="button" class="btn btn-sm btn-secondary required blink" id="idDupChckBtn"
                                    onclick="dF.User.idDupChckAjax();"
                                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.username-dup-check'/>">
                                <span class="hidden-table"><@spring.message 'txt.user.form.username'/></span><@spring.message 'txt.user.form.dup-check'/>
                            </button>
                            <input type="hidden" name="ipDupChckPassed" id="ipDupChckPassed" value="N"/>
                        </div>
                    </#if>
                    <#if isMdf!false>
                        <div class="col-xl-2">
                            <input type="hidden" name="username" id="username" value="${user.username!}" />
                            <div class="fw-bold col-form-label text-start">${user.username!}</div>
                        </div>
                    </#if>
                </div>
                <#if isReg!false>
                    <#--begin::Row-->
                    <div class="row mb-4">
                        <div class="col-xl-2">
                            <div class="fw-bold col-form-label text-lg-center text-sm-end  required">
                                <label for="password"><@spring.message 'txt.user.form.password'/></label>
                            </div>
                        </div>
                        <div class="col-xl-2">
                            <input type="password" name="password" id="password" class="form-control form-control-solid required no-space"
                                   maxlength="20" autocomplete="off" />
                            <div class="form-text text-noti">
                                <@spring.message 'txt.req.password'/>
                            </div>
                            <div id="password_validate_span"></div>
                        </div>
                        <div class="col-xl-2">
                            <div class="fw-bold col-form-label text-sm-start text-lg-end required">
                                <label for="passwordCf"><@spring.message 'txt.user.form.password-confirm'/></label>
                            </div>
                        </div>
                        <div class="col-xl-2">
                            <input type="password" name="passwordCf" id="passwordCf"  class="form-control form-control-solid no-space"
                                   maxlength="20" autocomplete="off" />
                            <div id="passwordCf_validate_span"></div>
                        </div>
                    </div>
                </#if>
                <#--begin::Row-->
                <div class="row mb-4">
                    <div class="col-xl-2">
                        <div class="fw-bold col-form-label text-lg-center text-sm-end required">
                            <label for="roleKey" class="cursor-help"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.role'/>">
                                <@spring.message 'txt.user.form.role'/>
                                <i class="bi bi-question-circle"></i>
                            </label>
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <select name="roleKeysStr" id="roleKey" class="form-select form-select-solid required"
                                data-control="select2" data-allow-clear="true" data-hide-search="true" data-close-on-select="false" multiple="multiple">
                            <#list roleList![] as auth>
                                <#assign is_selected = user.roleKeyList?? && user.roleKeyList?seq_contains(auth.roleKey) />
                                <option value="${auth.roleKey!}" <#if is_selected>selected</#if>>${auth.roleName!}</option>
                            </#list>
                        </select>
                        <div id="roleKey_validate_span"></div>
                    </div>
                </div>
                <#--begin::Row-->
                <!-- 가리고 숨기고를 반복하는 곳은 style로 선언해야 한다. -->
                <div class="row mb-4" id="nicknameShowDiv" <#if user.userInfo??>style="display:none;"</#if>>
                    <div class="col-xl-2">
                        <div class="fw-bold col-form-label text-lg-center text-sm-start required"
                             data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.nickname'/>">
                            <label for="nickname" class="cursor-help">
                                <@spring.message 'txt.user.form.nickname'/>
                                <i class="bi bi-question-circle"></i>
                            </label>
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <input type="text" name="nickname" id="nickname" class="form-control form-control-solid required"
                               value="${user.nickname!}" placeholder="<@spring.message 'txt.user.form.nickname'/>" maxlength="20" />
                        <div class="form-text text-noti">
                            <@spring.message 'txt.req.nicknm'/>
                        </div>
                        <span id="nickname_validate_span"></span>
                    </div>
                </div>
                <#--begin::Row-->
                <div class="row mb-4">
                    <div class="col-xl-2">
                        <div class="fw-bold col-form-label text-sm-start text-lg-center required">
                            <label for="emailId" class="cursor-help"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.email'/>">
                                E-mail
                                <i class="bi bi-question-circle"></i>
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-2 col-4">
                        <input type="text" name="emailId" id="emailId" class="form-control form-control-solid no-space"
                               value="${user.emailId!}" placeholder="<@spring.message 'txt.user.form.email-id-placeholder'/>" maxlength="20" />
                        <div id="emailId_validate_span"></div>
                    </div>
                    <div class="col-xl-2 col-1 d-flex-center fw-bold text-gray-700" style="width:2%;">
                        <label for="emailDomain"><label for="emailDomainSelect">@</label></label>
                    </div>
                    <div class="col-lg-2 col-5 vertical-center">
                        <input type="text" name="emailDomain" id="emailDomain" class="form-control form-control-solid no-space"
                               value="${user.emailDomain!"gmail.com"}" placeholder="<@spring.message 'txt.user.form.custom-input'/>" maxlength="20" />
                        <div id="emailDomain_validate_span"></div>
                    </div>
                    <div class="col-xl-2 col-1">
                        <select name="emailDomainSelect" id="emailDomainSelect" class="form-select form-select-solid">
                            <option value=""><@spring.message 'txt.user.form.custom-input'/></option>
                            <option value="gmail.com" <#if isReg!false>selected</#if>>gmail.com</option>
                            <option value="naver.com">naver.com</option>
                            <option value="kakao.com">kakao.com</option>
                        </select>
                    </div>
                    <div class="col-xl-2 col-4">
                        <button type="button" class="btn btn-sm btn-secondary required blink" id="emailDupChckBtn"
                                onclick="dF.User.emailDupChckAjax();"
                                data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.email-dup-check'/>">
                            <span class="hidden-table">EMAIL </span><@spring.message 'txt.user.form.dup-check'/>
                        </button>
                        <input type="hidden" name="emailDupChckPassed" id="emailDupChckPassed" value="N"/>
                    </div>
                </div>
                <#--begin::Row-->
                <div class="row mb-4">
                    <div class="col-xl-2">
                        <div class="fw-bold col-form-label text-sm-start text-lg-center">
                            <label for="phoneNumber">
                                <@spring.message 'txt.user.form.phone-number'/>
                            </label>
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <input type="text" name="phoneNumber" id="phoneNumber" class="form-control form-control-solid"
                               value="${user.phoneNumber!}" maxlength="20" />
                        <div class="form-text text-noti"><@spring.message 'txt.req.phoneNumber'/></div>
                        <span id="phoneNumber_valid_span"></span>
                    </div>
                </div>
                <#--begin::Row-->
                <div class="row mb-4">
                    <div class="col-xl-2">
                        <div class="fw-bold col-form-label text-lg-center text-sm-start ">
                            <label for="allowedIpListStr" class="cursor-help"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.allowed-ip'/>">
                                <@spring.message 'txt.user.form.allowed-ip'/>
                                <i class="bi bi-question-circle"></i>
                            </label>
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <div class="form-check form-switch form-check-custom form-check-solid mt-2">
                            <input type="checkbox" name="useAllowedIpYn" id="useAllowedIpYn" class="form-check-input cursor-pointer" value="Y"
                                   <#if user.useAllowedIp!false>checked="checked"</#if> />
                            <label class="form-check-label fw-bold ms-3" for="useAllowedIpYn" id="useAllowedIpYnLabel" style="color:<#if user.useAllowedIp!false>blue<#else>gray</#if>;">
                                <#if !user.useAllowedIp!false><@spring.message 'txt.status.unuse'/></#if><@spring.message 'txt.status.use'/>
                            </label>
                        </div>
                        <!-- 가리고 숨기고를 반복하는 곳은 style로 선언해야 한다. -->
                        <div id="allowedIpListSpan" class="mt-2 mb-0" <#if !(user.useAllowedIp!false)>style=display:none;"</#if>>
                            <input type="text" name="allowedIpListStr" id="allowedIpListStr" class="form-control form-control-solid no-space"
                                   value="${user.allowedIpListStr!}" maxlength="500" autocomplete="off" />
                            <div class="form-text text-noti"><@spring.message 'txt.req.acsip'/></div>
                            <div id="allowedIpListStr_valid_span"></div>
                        </div>
                    </div>
                </div>
                <#--begin::Row-->
                <div class="row mb-4">
                    <div class="col-xl-2">
                        <div class="fw-bold col-form-label text-sm-start text-lg-center">
                            <label for="content" class="cursor-help"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.account-description'/>">
                                <@spring.message 'txt.user.form.account-description'/>
                                <i class="bi bi-question-circle"></i>
                            </label>
                        </div>
                    </div>
                    <div class="col-xl-9">
                        <textarea name="content" id="content" class="form-control form-control-solid h-100px" wrap="hard" maxlength="4000" placeholder="<@spring.message 'txt.user.form.account-description-placeholder'/>">${user.content!}</textarea>
                    </div>
                </div>

                <#--사용자 프로필 정보 영역-->
                <div id="user_profile_div">
                    <#--handlebars template goes in here-->
                </div>

                <#--사용자 인사정보 영역-->
                <div id="user_emplym_div">
                    <#--handlebars template goes in here-->
                </div>
            </form>
            <!--end:Form-->
        </div>
        <#--begin::Card footer-->
        <div class="card-footer">
            <#--버튼 영역-->
            <div class="d-flex justify-content-between">
                <div>
                    <div class="d-flex gap-2">
                        <div id="user_profile_reg_btn_div">
                            <button type="button" id="userProfileBtn" class="btn btn-sm btn-primary blink"
                                    onclick="dF.UserProfile.enableUserProfile();"
                                    data-profile="{{profile}}"
                                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.add-profile'/>">
                                <@spring.message 'txt.user.form.add-profile'/>
                            </button>
                        </div>
                        <div>
                            <button type="button" id="userEmplymBtn" class="btn btn-sm btn-primary blink"
                                    onclick="dF.UserEmplym.enableUserEmplym();"
                                    data-emplym="{{emplym}}"
                                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.user.form.add-employment'/>">
                                <@spring.message 'txt.user.form.add-employment'/>
                            </button>
                            <div class="text-noti">
                                <@spring.message 'txt.req.user.emplym'/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="gap-2">
                    <#--페이지:: 버튼: 저장하기-->
                    <@component.post_btn_submit "cF.form.submit('#userRegForm');" />
                    <#--페이지:: 버튼: 목록으로 가기-->
                    <@component.post_btn_toList "dF.User.list();" />
                </div>
            </div>
        </div>
    </div>

    <form name="procForm" id="procForm" method="get">
        <input type="hidden" name="id" value="${user.id!}">
    </form>
</script>
