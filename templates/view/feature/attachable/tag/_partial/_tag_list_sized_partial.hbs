<#--
 * 태그 목록(sized) partial
 * @see handlebars.ts
-->

<script type="text/x-handlebars-template" id="tag_list_sized_partial" data-partial>
    <span class="py-2 me-3 cursor-pointer opacity-hover"
          onclick="{{module}}.select({{id}}, '{{tagNm}}', '{{ctgr}}');"
          data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message "view.tag.content-list"/>">
        <span class="{{tagClass}} {{textClass}}">
            {{#if (exists ctgr)}}
                <span class="fs-7 text-noti">[{{ctgr}}]</span>
            {{/if}}
            <span class="em_{{tagNm}}">{{tagNm}}</span>
        </span>
        <span class="fs-9 text-noti fw-normal" style="margin-left:-0.25em;">{{contentSize}}</span>
    </span>
</script>
