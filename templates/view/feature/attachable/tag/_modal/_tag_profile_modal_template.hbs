<#--
 * tag profile modal template
 -->

<script type="text/x-handlebars-template" id="tag_profile_modal_template">
    <form id="tagProfileForm" method="post">
        <input type="hidden" name="id" value="{{id}}">
        <input type="hidden" name="categoryProfileId" value="{{categoryProfileId}}">
        <input type="hidden" name="tagId" value="{{tagId}}">
        <input type="hidden" name="tagCategoryId" value="{{tagCategoryId}}">
        <input type="hidden" name="contentType" value="{{contentType}}">

        <div class="d-flex align-items-center gap-2 mb-5">
            <span class="badge badge-light-primary">{{contentTypeLabel}}</span>
            {{#if (exists ctgr)}}
                <span class="fs-7 text-noti">[{{ctgr}}]</span>
            {{/if}}
            <span class="fs-6 fw-bold text-primary"><span>#</span>{{tagNm}}</span>
        </div>

        <div class="row">
            <div class="col-6 mb-3 {{#if tagCategoryId}}{{else}}opacity-50{{/if}}" {{#if tagCategoryId}}{{else}}style="filter: grayscale(1); pointer-events: none;" aria-disabled="true"{{/if}}>
                <label for="tagCategoryTextClassCd" class="form-label fw-bold">
                    <span id="tagCategoryColorPreview">{{#if tagCategoryId}}[{{ctgr}}]{{/if}}</span> <@spring.message 'txt.attachable.tag.profile.category-tag-color'/>
                </label>
                <select id="tagCategoryTextClassCd" name="categoryTextClassCd" class="form-select form-select-solid" {{#if tagCategoryId}}{{else}}disabled{{/if}}>
                    <#list TEXT_CLASS_CD![] as item>
                        <option value="${item.code!}"
                                data-text-class="${item.description!}"
                                class="${item.description!}"
                                {{#if (equals categoryTextClassCd "${item.code!}")}}selected{{/if}}>
                            ${item.codeName!}
                        </option>
                    </#list>
                </select>
                {{#if tagCategoryId}}{{else}}
                    <div class="fs-8 text-muted mt-1 fw-bold"><@spring.message 'txt.attachable.tag.profile.no-category-guide'/></div>
                {{/if}}
            </div>

            <div class="col-6 mb-4">
                <label for="tagTextClassCd" class="form-label fw-bold"><span id="tagColorPreview"><span>#</span>{{tagNm}}</span> <@spring.message 'txt.attachable.tag.profile.individual-tag-color'/></label>
                <select id="tagTextClassCd" name="textClassCd" class="form-select form-select-solid">
                    <option value="" data-text-class="" class="" {{#unless textClassCd}}selected{{/unless}}>
                        {{#if tagCategoryId}}<@spring.message 'txt.attachable.tag.profile.same-as-category'/>{{else}}<@spring.message 'txt.attachable.tag.profile.default-no-category'/>{{/if}}
                    </option>
                    <#list TEXT_CLASS_CD![] as item>
                        <option value="${item.code!}"
                                data-text-class="${item.description!}"
                                class="${item.description!}"
                                {{#if (equals textClassCd "${item.code!}")}}selected{{/if}}>
                            ${item.codeName!}
                        </option>
                    </#list>
                </select>
            </div>
        </div>


        <label for="tagProfileCn" class="form-label fw-bold"><@spring.message 'txt.attachable.tag.profile.profile'/></label>
        <textarea id="tagProfileCn" name="content" class="form-control" rows="10"
                  placeholder="<@spring.message 'txt.attachable.tag.profile.profile-placeholder'/>">{{content}}</textarea>
    </form>
</script>
