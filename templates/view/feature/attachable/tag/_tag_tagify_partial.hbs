<#--
 * Handlebars 태그(tagify) 영역 partial
 -->

<#--begin::Row-->
<div class="row">
    <div>
        <label for="tagListStr" class="mb-2">
            <span class="text-gray-700 fs-6 fw-bolder"><@spring.message 'txt.attachable.tag.tagify.tag'/></span>
            <span class="text-gray-500 fs-9 mx-2"><@spring.message 'txt.attachable.tag.tagify.tag-guide'/></span>
        </label>
    </div>
    <div class="col-xl-12 text-sm-start" id="tag_div">
        <input name="tag.tagListStr" id="tagListStr" class="form-control form-control-solid no-space" autocomplete="off" value="{{tag.tagListStrWithCtgr}}"/>
        <div class="d-flex pt-2 gap-2">
            <div id="tag_ctgr_select_div" style="display: none; position: relative;">
                <select id="tag_ctgr_select" class="form-select orm-select-solid py-2">
                    <option value="custom"><@spring.message 'txt.user.form.custom-input'/></option>
                </select>
            </div>
            <div id="tag_ctgr_div" style="display:none;">
                <input type="text" id="tag_ctgr" class="form-control form-control-sm form-control-solid text-noti w-100px"
                       placeholder="<@spring.message 'txt.attachable.tag.tagify.category-placeholder'/>" maxlength="500">
            </div>
            <div id="tag_display_div" style="display:none;">
                <input type="text" id="tag_display" class="form-control form-control-sm form-control-solid text-dialog fw-bold fs-7 w-100px" disabled>
            </div>
        </div>
    </div>
</div>
