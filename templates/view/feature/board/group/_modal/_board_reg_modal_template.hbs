<#--
 * Board > register template
 * @included_in : _board_reg_modal.ftlh
-->

<script type="text/x-handlebars-template" id="board_reg_modal_template">
    <input type="hidden" name="regYn" value="{{#if (notExists id)}}Y{{/if}}{{#if (exists id)}}N{{/if}}">
    <input type="hidden" name="id" value="{{id}}">
    <input type="hidden" name="useYn" value="N">

    <div class="row mb-4">
        <div class="col-3 col-form-label text-center">
            <label class="cursor-help fw-bold required"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                   title="<@spring.message 'bs.tooltip.board.group.form.board-code'/>">
                <@spring.message 'txt.board.group.form.board-code'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-6">
            {{#if (exists boardKey)}}
                <div class="col-form-label">
                    <span class="text-noti fw-bold ps-1">{{boardKey}}</span>
                    <input type="hidden" name="boardKey" value="{{boardKey}}">
                </div>
            {{else}}
                <input type="text" name="boardKey" id="boardKey" class="form-control form-control-solid required cddata"
                       value="" placeholder="<@spring.message 'txt.board.group.form.board-code'/>" maxlength="16">
                <div class="text-noti"><@spring.message 'txt.board.group.form.board-code-guide'/></div>
                <div id="boardKey_validate_span"></div>
            {{/if}}
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-3 col-form-label text-center">
            <label class="cursor-help fw-bold required"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                   title="<@spring.message 'bs.tooltip.board.group.form.board-name'/>">
                <@spring.message 'txt.board.group.form.board-name'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-9">
            <input type="text" name="boardName" id="boardName" class="form-control form-control-solid required"
                   value="{{boardName}}" placeholder="<@spring.message 'txt.board.group.form.board-name'/>" maxlength="32">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-3 col-form-label text-center">
            <label class="cursor-help fw-bold required"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                   title="<@spring.message 'bs.tooltip.board.group.form.category-code'/>">
                <@spring.message 'txt.board.group.form.category-code'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-9">
            <input type="text" name="categoryGroupCode" id="categoryGroupCode" class="form-control form-control-solid required"
                   value="{{categoryGroupCode}}" placeholder="<@spring.message 'txt.board.group.form.category-code'/>" maxlength="32">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-3 col-form-label text-center">
            <label class="fw-bold"><@spring.message 'txt.board.group.form.board-description'/></label>
        </div>
        <div class="col-9">
            <textarea name="description" id="description" class="form-control form-control-solid h-100px"
                      wrap="hard" maxlength="1000" placeholder="<@spring.message 'txt.board.group.form.board-description-placeholder'/>">{{description}}</textarea>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-3 col-form-label text-center">
            <label class="cursor-help fw-bold"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                   title="<@spring.message 'bs.tooltip.board.group.form.use-yn'/>">
                <@spring.message 'txt.board.group.form.use-yn'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-9 text-center d-flex align-items-center">
            <div class="form-check form-switch form-check-custom form-check-solid">
                <input type="checkbox" name="useYn" id="useYn" class="form-check-input cursor-pointer"
                       value="Y" {{checkedYn useYn}}>
                <label class="form-check-label ms-3" for="useYn" id="useYnLabel" {{checkedYnStyle useYn "color" "blue//gray"}}>
                    {{#ifYn useYn}}<@spring.message 'txt.comm.use'/>{{else}}<@spring.message 'txt.status.unuse'/>{{/ifYn}}
                </label>
            </div>
        </div>
    </div>
</script>
