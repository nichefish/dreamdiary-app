<#--
 * 로그 > 상세 모달 Template
 * @included_in : _log_detail_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="log_detail_modal_template">
    <div class="mb-0">
        <div class="d-flex align-items-center mb-4">
            <div class="row">
                <h1 class="fs-2x fw-bolder text-gray-900 mb-0 me-1">
                    <span class="vertical-middle">{{title}}</span>
                </h1>
            </div>
        </div>
        <div class="separator separator-dashed border-gray-300 my-8"></div>
        <div class="fs-4 fw-normal text-gray-800 px-5 py-1 pb-6 min-h-150px">
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.log-type'/></div></div><div class="col-xl-10 col-8 col-form-label">{{actvtyCtgrNm}}</div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.actor'/></div></div><div class="col-xl-10 col-8 col-form-label">{{username}}</div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.action-datetime'/></div></div><div class="col-xl-10 col-8 col-form-label">{{logDt}}</div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.action-ip'/></div></div><div class="col-xl-10 col-8 col-form-label">{{ipAddr}}</div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold">URL</div></div><div class="col-xl-10 col-8 col-form-label"><div>{{url}}</div><div>referer: {{referer}}</div></div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.parameters'/></div></div><div class="col-xl-10 col-8 col-form-label">{{param}}</div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.action-content'/></div></div><div class="col-xl-10 col-8 col-form-label">{{content}}</div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.action-result'/></div></div><div class="col-xl-10 col-8 col-form-label"><div>{{rslt}}</div><div>{{rsltMsg}}</div></div></div>
            <div class="row mb-4"><div class="col-xl-2 col-4"><div class="col-form-label text-center fs-6 fw-bold"><@spring.message 'txt.admin.log.detail.exception'/></div></div><div class="col-xl-10 col-8 col-form-label"><div>{{exceptionNm}}</div><div>{{exceptionMsg}}</div></div></div>
        </div>
    </div>
</script>
