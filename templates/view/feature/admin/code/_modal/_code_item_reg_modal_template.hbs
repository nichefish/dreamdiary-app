<#--
 -- 코드 아이템 등록/수정 Template
 -- @included_in : _code_item_reg_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="code_item_reg_modal_template">
    <input type="hidden" name="id" value="{{id}}">
    <input type="hidden" name="groupCode" value="{{groupCode}}">
    <input type="hidden" name="regYn" value="{{#if (notExists code)}}Y{{/if}}{{#if (exists code)}}N{{/if}}">

    <div class="row mb-4">
        <div class="col-3 col-form-label text-center">
            <span class="cursor-help fw-bold required"><@spring.message 'txt.admin.code.item.form.code'/> <i class="bi bi-question-circle"></i></span>
        </div>
        <div class="col-4">
            {{#if (exists code)}}
            <div class="col-form-label">
                <span class="text-noti fw-bold ps-1">{{code}}</span>
                <input type="hidden" name="code" value="{{code}}">
            </div>
            {{/if}}
            {{#if (notExists code)}}
                <input type="text" name="code" id="code" class="form-control form-control-solid required" value="{{code}}" maxlength="30">
                <div class="text-noti"><@spring.message 'txt.admin.code.item.form.code-guide'/></div>
                <div id="code_validate_span"></div>
            {{/if}}
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-3 col-form-label text-center"><label class="cursor-help fw-bold required"><@spring.message 'txt.admin.code.item.form.code-name'/> <i class="bi bi-question-circle"></i></label></div>
        <div class="col-9">
            <input type="text" name="codeName" id="codeName" class="form-control form-control-solid required" value="{{codeName}}" maxlength="20">
            <div id="codeName_validate_span"></div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-3 col-form-label text-center"><label class="fw-bold"><@spring.message 'txt.admin.code.item.form.code-description'/></label></div>
        <div class="col-9">
            <textarea name="description" id="description" class="form-control form-control-solid h-100px" wrap="hard" maxlength="1000" placeholder="<@spring.message 'txt.admin.code.item.form.code-description-placeholder'/>">{{description}}</textarea>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-3 col-form-label text-center"><label class="cursor-help fw-bold"><@spring.message 'txt.admin.code.item.form.use-yn'/> <i class="bi bi-question-circle"></i></label></div>
        <div class="col-9 text-center d-flex align-items-center">
            <div class="form-check form-switch form-check-custom form-check-solid">
                <input type="checkbox" name="useYn" id="useYn" class="form-check-input cursor-pointer" value="Y" {{checkedYn useYn}} />
                <label class="form-check-label ms-3" for="useYn" id="useYnLabel" {{checkedYnStyle useYn "color" "blue//gray"}}>
                    {{#ifYn useYn}}<@spring.message 'txt.comm.use'/>{{else}}<@spring.message 'txt.status.unuse'/>{{/ifYn}}
                </label>
            </div>
        </div>
    </div>
</script>
