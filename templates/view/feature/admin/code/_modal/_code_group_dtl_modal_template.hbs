<#--
 * 코드 그룹 상세 템플릿
 * @included_in : _code_group_dtl_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="code_group_dtl_modal_template">
    <div class="mb-4">
        <div class="row mb-4">
            <h1 class="fs-2x fw-bolder text-gray-900 mb-0 me-1">
                <span class="vertical-middle">
                    {{#if (exists clCtgrNm)}}<span class="fw-bolder fs-2 ctgr-span ctgr-imprtc">{{clCtgrNm}}</span>{{/if}}
                    <span class="fw-bold">{{clCdNm}}</span>
                    (<span class="border-bottom">{{clCd}}</span>)
                </span>
            </h1>
        </div>
    </div>
    <div class="separator separator-dashed border-gray-300 my-8"></div>
    <div class="fs-4 fw-normal text-gray-800 px-5 py-1 pb-6 min-h-100px">{{description}}</div>
    <div class="separator separator-dashed border-gray-300 my-8"></div>
    <div class="d-flex justify-content-end mb-4">
        <button type="button" class="btn btn-sm btn-light-primary" onclick="dF.CodeItem.regModal();">
            <i class="bi bi-plus-lg"></i> 상세 코드 등록
        </button>
    </div>
    <table class="table align-middle table-row-dashed fs-small gy-5 table-fixed hoverTable mb-3">
        <thead>
            <tr class="text-start fw-bolder fs-7 text-uppercase gs-0 fw-bolder text-muted">
                <th class="col-1 text-center wb-keepall w-8">번호</th>
                <th class="col-2 text-center wb-keepall">상세 코드</th>
                <th class="col-2 text-center wb-keepall">상세 코드명</th>
                <th class="col-4 text-center wb-keepall">상세 코드 설명</th>
                <th class="col-1 text-center wb-keepall">사용 여부</th>
                <th class="col-1 text-center wb-keepall">관리</th>
            </tr>
        </thead>
        <tbody class="draggable-zone-dtl-cd">
            {{#each dtlCdList}}
                <tr class="bg-hover-secondary cursor-pointer sortable-item draggable-dtl-cd" id="{{dtlCd}}" data-id="{{dtlCd}}" onclick="dF.CodeItem.mdfModal('{{dtlCd}}');">
                    <td class="text-center">
                        <div class="draggable-handle-dtl-cd d-flex-center cursor-move px-2 py-1" onclick="event.stopPropagation();" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="순서 변경">
                            <i class="ki-duotone ki-abstract-14 fs-1"><span class="path1"></span><span class="path2"></span></i>
                            <span class="ms-2">{{rnum}}</span>
                        </div>
                    </td>
                    <td class="text-start ps-6"><span class="fw-bold border-bottom">{{dtlCd}}</span></td>
                    <td class="text-start ps-6"><span class="border-bottom">{{dtlCdNm}}</span></td>
                    <td class="text-start ps-6">{{description}}</td>
                    <td class="text-center">{{sortOrder}}</td>
                    <td class="text-center">
                        <span class="text-{{#ifYn useYn}}success{{else}}muted{{/ifYn}}">
                            {{#ifYn useYn}}사용<i class="bi bi-check text-success ms-1"></i>{{else}}미사용<i class="bi bi-dash text-muted ms-1"></i>{{/ifYn}}
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <div class="badge badge-danger badge-outlined cursor-pointer" onclick="event.stopPropagation(); dF.CodeItem.delAjax('{{dtlCd}}');" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.del'/>">
                                <i class="bi bi-trash text-danger fs-7 blink-slow"></i>
                                <@spring.message 'txt.comm.del'/>
                            </div>
                        </div>
                    </td>
                </tr>
            {{else}}
                <tr><td colspan="7" class="text-center"><@spring.message 'view.list.empty'/></td></tr>
            {{/each}}
        </tbody>
    </table>
</script>
