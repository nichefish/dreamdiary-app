<#--
 * 템플릿 관리(tmplat) > 등록 Template
 * @included_in : _tmplat_def_reg_modal.ftlh
 -->

<script type="text/x-handlebars-template" id="tmplat_def_reg_modal_template">
    <input type="hidden" name="id" id="id">

    <!--begin::title-->
    <div class="mb-0">
        <#--begin::Head-->
        <div class="row mb-4">
            <#--begin::title-->
            <div class="col-2 col-form-label">
                <label class="cursor-help required"
                      data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.admin.tmplat.def.form.def-code'/>">
                    <@spring.message 'txt.admin.tmplat.def.form.def-code'/>
                </label>
            </div>
            <div class="col-10">
                <input type="text" name="tmplatDefCd" id="tmplatDefCd" class="form-control {{#isMdf}}bg-secondary{{/isMdf}}"
                       {{#isMdf}}data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.admin.tmplat.def.form.def-code-readonly'/>"{{/isMdf}}
                       value="{{tmplatDefCd}}" maxlength="50" {{#isMdf}}readonly{{/isMdf}}>
            </div>
            <!--end::Title-->
        </div>
        <div class="row mb-4">
            <#--begin::title-->
            <div class="col-2 col-form-label">
                <label class="cursor-help required"
                      data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.admin.tmplat.def.form.def-name'/>">
                    <@spring.message 'txt.admin.tmplat.def.form.def-name'/>
                </label>
            </div>
            <div class="col-10">
                <input type="text" name="title" id="title" class="form-control"
                       value="{{title}}" maxlength="50">
            </div>
            <!--end::Title-->
        </div>
        <div class="row mb-4">
            <#--begin::title-->
            <div class="col-2 col-form-label">
                <@spring.message 'txt.admin.tmplat.def.form.def-description'/>
            </div>
            <div class="col-10">
                <textarea name="description" id="description" class="form-control h-75px">{{description}}</textarea>
            </div>
            <!--end::Title-->
        </div>
        <div class="row mb-4">
            <#--begin::title-->
            <div class="col-2 col-form-label">
                <@spring.message 'txt.admin.tmplat.def.form.use-yn'/>
            </div>
            <div class="col-10">
                <div class="form-check form-switch mt-2 form-check-custom form-check-solid">
                    <input type="checkbox" name="useYn" id="useYn" class="form-check-input cursor-pointer ms-3"
                           value="Y" />
                    <label class="form-check-label fw-bold ms-3" for="useYn" id="useYnLabel"><@spring.message 'txt.status.unuse'/></label>
                </div>
            </div>
            <!--end::Title-->
        </div>
        <!--end::Head-->
        <div class="row mb-4">
            <#--begin::title-->
            <div class="col-2 col-form-label">
                <@spring.message 'txt.admin.tmplat.def.form.sort-order'/>
            </div>
            <div class="col-10">
                <input type="text" name="sortOrder" id="sortOrder" class="form-control"
                       value="{{sortOrder}}" maxlength="3">
            </div>
            <!--end::Title-->
        </div>
    </div>
</script>
