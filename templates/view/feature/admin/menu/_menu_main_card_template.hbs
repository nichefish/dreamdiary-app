<#--
 -- menu(menu) > main card template
 -- @included_in : menu_page.ftlh
 -->

<script type="text/x-handlebars-template" id="menu_main_card_template">
    <li class="menu-item col-4 list-unstyled p-5 sortable-item draggable-main" style="{{borderColor}}"
        data-id="{{id}}" data-type="{{menuTyCd}}" data-upper-menu-id="{{upperMenuId}}" data-sort-order="{{sortOrder}}" data-use-yn="{{useYn}}">
        <div class="card shadow">
            <div class="card-header pt-2">
                <div class="d-flex align-items-center">
                    {{#unlessYn protectedYn}}
                        <div class="draggable-handle-main cursor-move pt-2"
                             data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="Drag to move">
                            <i class="ki-duotone ki-abstract-14 fs-2x">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                    {{/unlessYn}}
                    <i class="{{icon}} text-info fs-3 ms-4"></i>
                    <h2 class="mx-2 mb-0 text-info cursor-default text-underline-dotted">
                        <span class="title {{^ifYn useYn}}strikethrough{{/ifYn}}">
                            {{menuNm}}
                            {{#ifYn protectedYn}}
                                <i class="bi bi-shield-lock text-muted"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.menu.protected'/>"></i>
                            {{/ifYn}}
                            {{#ifYn requiredYn}}
                                <i class="bi bi-exclamation-diamond text-warning"
                                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.menu.required'/>"></i>
                            {{/ifYn}}
                            <span class="badge bg-light-info text-info ms-1">{{menuLabel}}</span>
                        </span>
                    </h2>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <div class="w-40px">
                        {{> menu_context_btn_partial this}}
                    </div>
                </div>
            </div>

            <ul id="menu_sub_{{id}}"
                class="card-body ps-12 sub-menu-list custom-scroll {{#unlessYn protectedYn}}{{#if (equals menuSubExtendTyCd 'NO_SUB')}}{{else}}draggable-zone-sub{{/if}}{{/unlessYn}}"
                data-parent-menu-id="{{id}}"
                data-parent-menu-ty="{{menuTyCd}}">
                <!-- sub-menu area -->
            </ul>
        </div>
    </li>
</script>
