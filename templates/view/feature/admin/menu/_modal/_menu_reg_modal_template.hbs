<#--
 * 메뉴(menu) > 카드 Template
 * @included_in : menu_page.ftlh
 -->

<script type="text/x-handlebars-template" id="menu_reg_modal_template">
    <!-- form start -->
    <input type="hidden" name="id" id="id" value="{{id}}">
    <input type="hidden" name="menuTyCd" id="menuTyCd" value="{{menuTyCd}}">
    <input type="hidden" name="upperMenuId" id="upperMenuId" value="{{upperMenuId}}">

    <#--begin::Row-->
    <div class="row mb-4">
        {{#if (equals menuTyCd "${Code.MENU_TY_MAIN!}")}}
            <div class="col-2 text-center">
                <label for="menuNm" class="col-form-label fw-bold">
                    <@spring.message 'txt.admin.menu.form.manager-menu-yn'/>
                </label>
            </div>
            <div class="col-10">
                <div class="form-check form-switch mt-2 form-check-custom form-check-solid">
                    <input type="checkbox" name="mngrYn" id="useYn" class="form-check-input cursor-pointer"
                           value="Y" {{checkedYn mngrYn}} />
                    <label class="form-check-label ms-3" for="useYn" id="useYnLabel" {{checkedYnStyle mngrYn "color" "blue//gray"}}>
                        {{^ifYn mngrYn}}<@spring.message 'txt.admin.menu.form.not-prefix'/>{{/ifYn}}<@spring.message 'txt.admin.menu.form.applicable'/>
                    </label>
                </div>
            </div>
        {{else}}
            <div class="col-2 text-center">
                <label for="menuNm" class="col-form-label fw-bold">
                    <@spring.message 'txt.admin.menu.form.upper-menu-name'/>
                </label>
            </div>
            <div class="col-10 col-form-label">
                <div class="ps-2 text-gray-600 ls-1">
                    {{upperMenuNm}}
                </div>
            </div>
        {{/if}}
    </div>
    <#--begin::Row-->
    <div class="row mb-4">
        <div class="col-2 text-center">
            <label for="menuNm" class="col-form-label fw-bold required">
                <@spring.message 'txt.admin.menu.form.menu-name'/>
            </label>
        </div>
        <div class="col-4">
            <input type="text" name="menuNm" id="menuNm" class="form-control d-inline-block required"
                   value="{{menuNm}}" maxlength="200" autocomplete="off">
            <span id="menuNm_validate_span"></span>
        </div>
        <div class="col-2 text-center">
            <label for="menuLabel" class="col-form-label fw-bold cursor-help"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.admin.menu.form.menu-label'/>">
                <@spring.message 'txt.admin.menu.form.menu-label'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-4">
            <input type="text" name="menuLabel" id="menuLabel" class="form-control d-inline-block {{#ifYn protectedYn}}cursor-not-allowed form-control-solid{{/ifYn}}" {{#ifYn protectedYn}}readonly{{/ifYn}}
                   value="{{menuLabel}}" maxlength="200" autocomplete="off">
            <span id="menuLabel_validate_span"></span>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row mb-4">
        <div class="col-2 text-center">
            <label for="menuNm" class="col-form-label fw-bold cursor-help"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                   title="<@spring.message 'bs.tooltip.admin.menu.form.menu-icon'/>">
                <@spring.message 'txt.admin.menu.form.menu-icon'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-1 d-flex-center flex-column gap-3">
            <div id="menu_icon_div" class="cursor-pointer"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                 title="<@spring.message 'bs.tooltip.admin.menu.form.icon-preview'/>">
                {{#if (exists icon)}}
                    {{{icon}}}
                {{else}}
                    -
                {{/if}}
            </div>
            <div class="btn btn-sm btn-icon btn-light-primary"
                 onclick="dF.Menu.refreshIcon();"
                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.admin.menu.form.refresh-icon-preview'/>">
                <i class="bi bi-arrow-repeat"></i>
            </div>
        </div>
        <div class="col-9">
            <textarea name="icon" id="icon" class="form-control form-control-solid d-block"
                      placeholder="<@spring.message 'txt.admin.menu.form.icon-placeholder'/>" maxlength="1000" rows="5" >{{icon}}</textarea>
            <div id="icon_validate_span"></div>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row mb-4">
        <div class="col-2 text-center">
            <label for="url" class="col-form-label fw-bold">
                <@spring.message 'txt.admin.menu.form.unread-count-name'/>
            </label>
        </div>
        <div class="col-10">
            <input type="text" name="unreadCntNm" id="unreadCntNm" class="form-control"
                   value="{{unreadCntNm}}" maxlength="1000">
            <div id="url_validate_span"></div>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row mb-4">
        <div class="col-2 text-center">
            <label for="url" class="cursor-help fw-bold required"
                   data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click"
                   title="<@spring.message 'bs.tooltip.admin.menu.form.submenu-display-type'/>">
                <@spring.message 'txt.admin.menu.form.submenu-display-type'/>
                <i class="bi bi-question-circle"></i>
            </label>
        </div>
        <div class="col-3">
            <select name="menuSubExtendTyCd" id="menuSubExtendTyCd" class="form-select form-select-solid required"
                    onchange="dF.Menu.toggleUrlSpan(this);">
                <option value="">----</option>
                <#list MENU_SUB_EXTEND_TY_CD![] as menuSubExtend>
                    <option value="${menuSubExtend.code!}" {{selectedIf (equals menuSubExtendTyCd "${menuSubExtend.code!}")}}>
                        ${menuSubExtend.codeName!}
                    </option>
                </#list>
            </select>
            <div id="menuSubExtendTyCd_validate_span"></div>
        </div>
    </div>
    <#--begin::Row-->
    <div class="row mb-4 {{^if (equals menuSubExtendTyCd "NO_SUB")}}d-none{{/if}}" id="url_div">
        <div class="col-2 text-center">
            <label for="url" class="col-form-label fw-bold">
                <@spring.message 'txt.admin.menu.form.menu-url'/>
            </label>
        </div>
        <div class="col-10">
            <input type="text" name="url" id="url" class="form-control"
                   value="{{url}}" maxlength="1000">
            <div id="url_validate_span"></div>
        </div>
    </div>
</script>
