<#--
 -- menu(menu) > sub menu template
 -- @included_in : menu_page.ftlh
 -->

<script type="text/x-handlebars-template" id="menu_sub_template">
    <li class="menu-item list-unstyled sortable-item draggable-sub" style="{{borderColor}}"
        data-id="{{id}}" data-type="{{menuTyCd}}" data-upper-menu-id="{{upperMenuId}}" data-sort-order="{{sortOrder}}" data-use-yn="{{useYn}}">
        {{#if (equals upperMenuTyCd 'MAIN')}}
            <div class="menu-label fw-bolder text-muted fs-6 pb-1">{{ifEmpty menuLabel "-"}}</div>
        {{/if}}
        <div class="d-flex align-items-center justify-content-between rounded">
            <div class="d-flex align-items-center">
                {{#unlessYn protectedYn}}
                    <div class="draggable-handle-sub cursor-move pt-1"
                         data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="Drag to move">
                        <i class="ki-duotone ki-abstract-14 fs-2x">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                    </div>
                {{/unlessYn}}
                {{#if (exists icon)}}
                    <span class="ps-3 pe-0">
                        {{{icon}}}
                    </span>
                {{else}}
                    <span class="ps-3 pe-0">
                        -
                    </span>
                {{/if}}
                <div class="ms-3 mb-0 text-dark cursor-default text-underline-dotted">
                    <span class="title fs-5 {{^ifYn useYn}}strikethrough{{/ifYn}}">
                        {{menuNm}}
                        {{#ifYn protectedYn}}
                            <i class="bi bi-shield-lock text-muted"
                               data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.menu.protected'/>"></i>
                        {{/ifYn}}
                        {{#ifYn requiredYn}}
                            <i class="bi bi-exclamation-diamond text-warning"
                               data-bs-toggle="tooltip" data-bs-placement="top" data-bs-dismiss="click" title="<@spring.message 'bs.tooltip.menu.required'/>"></i>
                        {{/ifYn}}
                        <span class="badge bg-secondary text-{{#if (equals upperMenuTyCd 'MAIN')}}dark{{else}}muted{{/if}} ms-1">
                            {{ifEmpty menuLabel "-"}}
                        </span>
                    </span>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-end">
                <div class="w-40px">
                    {{> menu_context_btn_partial this}}
                </div>
            </div>
        </div>
        <ul id="menu_sub_{{id}}"
            class="sub-menu-list custom-scroll {{#unlessYn protectedYn}}{{#if (equals menuSubExtendTyCd 'NO_SUB')}}{{else}}draggable-zone-sub{{/if}}{{/unlessYn}}"
            data-parent-menu-id="{{id}}"
            data-parent-menu-ty="{{menuTyCd}}">
            <!-- sub-menu area -->
        </ul>
    </li>
</script>
